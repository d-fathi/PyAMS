 font-family: &quot;Times New Roman&quot;; display: none;">-</text><ellipse cx="15" cy="26.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,25 16.5,25 15,23.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="15,16 15,10 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="15,30 15,24 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><text class="var" name="ref" x="35" y="18" r="0" rtemp="0" transform="rotate(0 35 18)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">C4</text><polyline points="5,16 25,16 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="5,24 25,24 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><text class="var" name="param" x="34" y="28" r="0" rtemp="0" transform="rotate(0 34 28)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;" show="Value only" paramname="C" paramvalue="360pF">360pF</text></g><polyline points="330,315 330,270 330,270 " class="polyline" name="net" xdir="true" ref="N09" parent="false" parentcolor="false" used="true" id="18" node0="-1" node1="17" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="250,350 250,365 330,365 330,345 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="19" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="435,320 435,295 435,295 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="20" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="300,380 300,365 300,365 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="21" node0="-1" node1="19" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="200,190 200,175 200,175 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="22" node0="-1" node1="6" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><text class="draggable" name="text" x="424" y="78" r="0" rtemp="0" transform="rotate(0 424 78)" style="fill: rgb(255, 123, 0); font-weight: bolder; font-style: normal; font-size: 12px; font-family: bolder;">V(x)</text><text class="draggable" name="text" x="334" y="79" r="0" rtemp="0" transform="rotate(0 334 79)" style="fill: rgb(255, 123, 0); font-weight: bolder; font-style: normal; font-size: 12px; font-family: normal;">V(y)</text><g transform="translate(590,84)" x="590" y="84" title="codeHTML" width="475" height="539" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="222" height="200" style="height: 539px; width: 791.667px;"><div name="htmlCode" style="zoom: 60%; height: 539px; width: 791.667px;" code="&lt;div class=&quot;ch&quot;&gt;
    
    &lt;h1&gt;Chaotic Oscillator Circuit - SPICE Time Domain Analysis&lt;/h1&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Circuit Components&lt;/h2&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;Transistors (Q1, Q2):&lt;/strong&gt; BC549C NPN&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Resistors:&lt;/strong&gt; R1=5kΩ, R2=10kΩ, R3=10kΩ, R4=5kΩ, R5=31kΩ, R6=47kΩ, R7=15kΩ&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Capacitors:&lt;/strong&gt; C1=C2=C3=1nF, C4=360pF&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Power Supply:&lt;/strong&gt; V1 = 5V DC&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Analysis Type:&lt;/strong&gt; XY Plot (Phase Portrait)&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

    &lt;h2&gt;Circuit Type&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        This is a &lt;strong&gt;chaotic oscillator circuit&lt;/strong&gt; that exhibits nonlinear dynamics and produces a strange attractor in phase space.
    &lt;/div&gt;

    &lt;h2&gt;Simulation Results&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;

        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Phase Portrait (V(y) vs V(x))&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Pattern:&lt;/strong&gt; Figure-8 shape (double-scroll attractor)&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Behavior:&lt;/strong&gt; Chaotic oscillation with bounded trajectory&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;V(x) range:&lt;/strong&gt; 0.64V to 0.7V&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;V(y) range:&lt;/strong&gt; 0.5V to 1.3V&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Trajectory:&lt;/strong&gt; Never repeats exactly (sensitive to initial conditions)&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;Chaotic Characteristics&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Non-periodic:&lt;/strong&gt; Output never repeats the same pattern&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Deterministic:&lt;/strong&gt; Governed by circuit equations, not random&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Bounded:&lt;/strong&gt; Trajectory stays within finite region&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Strange Attractor:&lt;/strong&gt; Complex fractal-like structure&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Sensitive Dependence:&lt;/strong&gt; Small changes lead to different trajectories&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

    &lt;/div&gt;

    &lt;div class=&quot;ch-card green-border&quot;&gt;
        &lt;h2&gt;Conclusion&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;This circuit demonstrates &lt;strong&gt;chaotic behavior&lt;/strong&gt; through its nonlinear transistor dynamics and feedback network. The XY plot reveals a double-scroll strange attractor, characteristic of chaotic systems. Unlike periodic oscillators, this circuit produces a deterministic but unpredictable output that never exactly repeats. The chaotic oscillation arises from the interaction between the two transistors, the RC network, and the nonlinear characteristics of the transistors operating in their active regions.&lt;/p&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card&quot; style=&quot;background-color: #e8f8f5; border-left: 4px solid #1abc9c;&quot;&gt;
        &lt;h2 style=&quot;color: #16a085;&quot;&gt;Applications of Chaotic Circuits&lt;/h2&gt;
        &lt;ul style=&quot;line-height: 1.6; margin: 0;&quot;&gt;
            &lt;li&gt;&lt;strong&gt;Secure Communications:&lt;/strong&gt; Chaos-based encryption&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Random Number Generation:&lt;/strong&gt; True hardware randomness&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Spread Spectrum:&lt;/strong&gt; Chaotic signal modulation&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Neural Networks:&lt;/strong&gt; Chaotic neuron models&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Testing:&lt;/strong&gt; Complex signal generation for system testing&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

&lt;/div&gt;"> 
    <!-- Parent container that responds to mouse movement -->
    <div class="chtool"> 
        
        <!-- tool bar-->
        <div class="ch-page-toolbar">
            <button class="ch-toolbar-button" title="Home" onclick="goHome()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3 L3 10 V21 H9 V15 H15 V21 H21 V10 Z"></path>
                </svg>
