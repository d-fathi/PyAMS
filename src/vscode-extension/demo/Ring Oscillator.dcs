yer-above"><g class="imagelayer"></g><g class="shapelayer"></g></g><g class="infolayer"><g class="legend" pointer-events="all" transform="translate(690.86,35)"><rect class="bg" shape-rendering="crispEdges" style="stroke: rgb(68, 68, 68); stroke-opacity: 1; fill: rgb(255, 255, 255); fill-opacity: 1; stroke-width: 0px;" width="102" height="67" x="0" y="0"></rect><g class="scrollbox" transform="" clip-path="url('#legend20c488')"><g class="groups"><g class="traces" transform="translate(0,14.5)" style="opacity: 1;"><text class="legendtext" text-anchor="start" x="40" y="4.29" data-unformatted="V(Out1) [V]" data-math="N" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">V(Out1) [V]</text><g class="layers" style="opacity: 1;"><g class="legendfill"></g><g class="legendlines"><path class="js-line" d="M5,0h30" style="fill: none; stroke: rgb(185, 24, 24); stroke-opacity: 1; stroke-width: 2px;"></path></g><g class="legendsymbols"><g class="legendpoints"></g></g></g><rect class="legendtoggle" pointer-events="all" x="0" y="-9.5" width="96.7222671508789" height="19" style="cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;"></rect></g><g class="traces" transform="translate(0,33.5)" style="opacity: 1;"><text class="legendtext" text-anchor="start" x="40" y="4.29" data-unformatted="V(Out2) [V]" data-math="N" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">V(Out2) [V]</text><g class="layers" style="opacity: 1;"><g class="legendfill"></g><g class="legendlines"><path class="js-line" d="M5,0h30" style="fill: none; stroke: rgb(50, 55, 200); stroke-opacity: 1; stroke-width: 2px;"></path></g><g class="legendsymbols"><g class="legendpoints"></g></g></g><rect class="legendtoggle" pointer-events="all" x="0" y="-9.5" width="96.7222671508789" height="19" style="cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;"></rect></g><g class="traces" transform="translate(0,52.5)" style="opacity: 1;"><text class="legendtext" text-anchor="start" x="40" y="4.29" data-unformatted="V(Out3) [V]" data-math="N" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">V(Out3) [V]</text><g class="layers" style="opacity: 1;"><g class="legendfill"></g><g class="legendlines"><path class="js-line" d="M5,0h30" style="fill: none; stroke: rgb(22, 202, 133); stroke-opacity: 1; stroke-width: 2px;"></path></g><g class="legendsymbols"><g class="legendpoints"></g></g></g><rect class="legendtoggle" pointer-events="all" x="0" y="-9.5" width="96.7222671508789" height="19" style="cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;"></rect></g></g></g><rect class="scrollbar" rx="20" ry="3" width="0" height="0" style="fill: rgb(128, 139, 164); fill-opacity: 1;" x="0" y="0"></rect></g><g class="g-gtitle"></g><g class="g-xtitle"><text class="xtitle" x="356.5" y="382" text-anchor="middle" data-unformatted="Time[sec]" data-math="N" style="font-family: Arial; font-size: 13px; fill: rgb(51, 51, 51); opacity: 1; font-weight: normal; white-space: pre;">Time[sec]</text></g><g class="g-ytitle"></g></g><g class="menulayer"></g><g class="zoomlayer"></g></svg><div class="modebar-container" style="position: absolute; top: 0px; right: 0px; width: 100%;"><div id="modebar-20c488" class="modebar modebar--hover ease-bg"><div class="modebar-group"><a rel="tooltip" class="modebar-btn" data-title="Download plot as a png" data-toggle="false" data-gravity="n"><svg viewBox="0 0 1000 1000" class="icon" height="1em" width="1em"><path d="m500 450c-83 0-150-67-150-150 0-83 67-150 150-150 83 0 150 67 150 150 0 83-67 150-150 150z m400 150h-120c-16 0-34 13-39 29l-31 93c-6 15-23 28-40 28h-340c-16 0-34-13-39-28l-31-94c-6-15-23-28-40-28h-120c-55 0-100-45-100-100v-450c0-55 45-100 100-100h800c55 0 100 45 100 100v450c0 55-45 100-100 100z m-400-550c-138 0-250 112-250 250 0 138 112 250 250 250 138 0 250-112 250-250 0-138-112-250-250-250z m365 380c-19 0-35 16-35 35 0 19 16 35 35 35 19 0 35-16 35-35 0-19-16-35-35-35z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a></div><div class="modebar-group"><a rel="tooltip" class="modebar-btn active" data-title="Zoom" data-attr="dragmode" data-val="zoom" data-toggle="false" data-gravity="n"><svg viewBox="0 0 1000 1000" class="icon" height="1em" width="1em"><path d="m1000-25l-250 251c40 63 63 138 63 218 0 224-182 406-407 406-224 0-406-182-406-406s183-406 407-406c80 0 155 22 218 62l250-250 125 125z m-812 250l0 438 437 0 0-438-437 0z m62 375l313 0 0-312-313 0 0 312z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a><a rel="tooltip" class="modebar-btn" data-title="Pan" data-attr="dragmode" data-val="pan" data-toggle="false" data-gravity="n"><svg viewBox="0 0 1000 1000" class="icon" height="1em" width="1em"><path d="m1000 350l-187 188 0-125-250 0 0 250 125 0-188 187-187-187 125 0 0-250-250 0 0 125-188-188 186-187 0 125 252 0 0-250-125 0 187-188 188 188-125 0 0 250 250 0 0-126 187 188z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a></div><div class="modebar-group"><a rel="tooltip" class="modebar-btn" data-title="Zoom in" data-attr="zoom" data-val="in" data-toggle="false" data-gravity="n"><svg viewBox="0 0 875 1000" class="icon" height="1em" width="1em"><path d="m1 787l0-875 875 0 0 875-875 0z m687-500l-187 0 0-187-125 0 0 187-188 0 0 125 188 0 0 187 125 0 0-187 187 0 0-125z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a><a rel="tooltip" class="modebar-btn" data-title="Zoom out" data-attr="zoom" data-val="out" data-toggle="false" data-gravity="n"><svg viewBox="0 0 875 1000" class="icon" height="1em" width="1em"><path d="m0 788l0-876 875 0 0 876-875 0z m688-500l-500 0 0 125 500 0 0-125z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a><a rel="tooltip" class="modebar-btn" data-title="Autoscale" data-attr="zoom" data-val="auto" data-toggle="false" data-gravity="n"><svg viewBox="0 0 1000 1000" class="icon" height="1em" width="1em"><path d="m250 850l-187 0-63 0 0-62 0-188 63 0 0 188 187 0 0 62z m688 0l-188 0 0-62 188 0 0-188 62 0 0 188 0 62-62 0z m-875-938l0 188-63 0 0-188 0-62 63 0 187 0 0 62-187 0z m875 188l0-188-188 0 0-62 188 0 62 0 0 62 0 188-62 0z m-125 188l-1 0-93-94-156 156 156 156 92-93 2 0 0 250-250 0 0-2 93-92-156-156-156 156 94 92 0 2-250 0 0-250 0 0 93 93 157-156-157-156-93 94 0 0 0-250 250 0 0 0-94 93 156 157 156-157-93-93 0 0 250 0 0 250z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a></div><div class="modebar-group"><a rel="tooltip" class="modebar-btn" data-title="Toggle Spike Lines" data-attr="_cartesianSpikesEnabled" data-val="on" data-toggle="false" data-gravity="n"><svg viewBox="0 0 1000 1000" class="icon" height="1em" width="1em"><path d="M512 409c0-57-46-104-103-104-57 0-104 47-104 104 0 57 47 103 104 103 57 0 103-46 103-103z m-327-39l92 0 0 92-92 0z m-185 0l92 0 0 92-92 0z m370-186l92 0 0 93-92 0z m0-184l92 0 0 92-92 0z" transform="matrix(1.5 0 0 -1.5 0 850)"></path></svg></a><a rel="tooltip" class="modebar-btn" data-title="Show closest data on hover" data-attr="hovermode" data-val="closest" data-toggle="false" data-gravity="ne"><svg viewBox="0 0 1500 1000" class="icon" height="1em" width="1em"><path d="m375 725l0 0-375-375 375-374 0-1 1125 0 0 750-1125 0z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a><a rel="tooltip" class="modebar-btn active" data-title="Compare data on hover" data-attr="hovermode" data-val="x" data-toggle="false" data-gravity="ne"><svg viewBox="0 0 1125 1000" class="icon" height="1em" width="1em"><path d="m187 786l0 2-187-188 188-187 0 0 937 0 0 373-938 0z m0-499l0 1-187-188 188-188 0 0 937 0 0 376-938-1z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a></div><div class="modebar-group"><a rel="tooltip" class="modebar-btn" data-title="Open in New Window" data-toggle="false" data-gravity="n"><svg viewBox="0 0 1000 1000" class="icon" height="1em" width="1em"><path d="M786 296v-267q0-15-11-26t-25-10h-214v214h-143v-214h-214q-15 0-25 10t-11 26v267q0 1 0 2t0 2l321 264 321-264q1-1 1-4z m124 39l-34-41q-5-5-12-6h-2q-7 0-12 3l-386 322-386-322q-7-4-13-4-7 2-12 7l-35 41q-4 5-3 13t6 12l401 334q18 15 42 15t43-15l136-114v109q0 8 5 13t13 5h107q8 0 13-5t5-13v-227l122-102q5-5 6-12t-4-13z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a></div></div></div><svg class="main-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="805" height="413.33333333333337"><g class="hoverlayer"></g></svg></div></div></div></foreignObject></g><polyline points="375,275 375,260 375,260 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="25" node0="-1" node1="7" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><text class="draggable" name="text" x="212" y="177" r="0" rtemp="0" transform="rotate(0 212 177)" style="fill: rgb(185, 24, 24); font-weight: bold; font-style: normal; font-size: 9px; font-family: bold;">V(out1)</text><text class="draggable" name="text" x="377" y="175" r="0" rtemp="0" transform="rotate(0 377 175)" style="fill: rgb(50, 50, 200); font-weight: bold; font-style: normal; font-size: 8px; font-family: bold;">V(out2)</text><text class="draggable" name="text" x="546" y="175" r="0" rtemp="0" transform="rotate(0 546 175)" style="fill: rgb(54, 179, 181); font-weight: bold; font-style: normal; font-size: 8px; font-family: bold;">V(out3)</text><g transform="translate(677,18)" x="677" y="18" title="codeHTML" width="514" height="694" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="222" height="200" style="height: 694px; width: 856.667px;"><div name="htmlCode" style="zoom: 60%; height: 694px; width: 856.667px;" code="&lt;div class=&quot;ch&quot;&gt;
    
    &lt;h1&gt;3-Stage CMOS Ring Oscillator with RC Phase Shift - SPICE Time Domain Analysis&lt;/h1&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Circuit Components&lt;/h2&gt;
        &lt;h3 style=&quot;color: #2980b9;&quot;&gt;Three CMOS Inverter Stages&lt;/h3&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;Stage 1:&lt;/strong&gt; M1 (PMOS) + M2 (NMOS) → Output V(out1)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Stage 2:&lt;/strong&gt; M3 (PMOS) + M4 (NMOS) → Output V(out2)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Stage 3:&lt;/strong&gt; M5 (PMOS) + M6 (NMOS) → Output V(out3)&lt;/li&gt;
        &lt;/ul&gt;
        &lt;h3 style=&quot;color: #c0392b; margin-top: 15px;&quot;&gt;RC Phase-Shift Networks&lt;/h3&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;R1, R2, R3:&lt;/strong&gt; 100 Ω each (series resistors)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;C1, C2, C3:&lt;/strong&gt; 50 μF each (shunt capacitors to ground)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Vcc:&lt;/strong&gt; 10V DC power supply&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Analysis:&lt;/strong&gt; Time Domain (0s to 1.5s)&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

    &lt;h2&gt;Oscillation Principle (Barkhausen Criterion)&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        Total Phase Shift = 3 × (180° inverter + 60° RC network) = 3 × 240° = 720° ≡ 0° (mod 360°)&lt;br&gt;
        Each RC stage provides ≈ 60° phase shift at oscillation frequency&lt;br&gt;
        f ≈ 1 / (2π·R·C·√6) ≈ 1 / (2π × 100 × 50μ × 2.45) ≈ &lt;strong&gt;13 Hz&lt;/strong&gt; (approximate)&lt;br&gt;
        Observed period ≈ 0.2s → f ≈ &lt;strong&gt;5 Hz&lt;/strong&gt; (due to MOSFET delays)
    &lt;/div&gt;

    &lt;h2&gt;Simulation Results&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;

        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Startup Phase (0 to ~0.75s)&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;All three outputs settle at ~4.5-5V (metastable point)&lt;/li&gt;
                &lt;li&gt;Circuit is in unstable equilibrium (Vout ≈ Vcc/2)&lt;/li&gt;
                &lt;li&gt;Small noise/imbalance triggers oscillation&lt;/li&gt;
                &lt;li&gt;Gradual growth of oscillation amplitude&lt;/li&gt;
                &lt;li&gt;Positive feedback builds up the signal&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;Steady-State Oscillation (~0.8s to 1.5s)&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;Three sinusoidal waveforms with 120° phase shift&lt;/li&gt;
                &lt;li&gt;Amplitude: ~1V to ~9V (near rail-to-rail)&lt;/li&gt;
                &lt;li&gt;Frequency: ~5 Hz (period ≈ 0.2s)&lt;/li&gt;
                &lt;li&gt;V(out1), V(out2), V(out3) are equally spaced in phase&lt;/li&gt;
                &lt;li&gt;Stable sustained oscillation achieved&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

    &lt;/div&gt;

    &lt;div class=&quot;ch-card green-border&quot;&gt;
        &lt;h2&gt;Conclusion&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;This circuit is a &lt;strong&gt;3-Stage CMOS Ring Oscillator&lt;/strong&gt; with RC phase-shift networks between stages. Each CMOS inverter provides 180° phase inversion, while each RC network adds approximately 60° of additional phase shift, giving a total of 240° per stage. With three stages, the total phase shift is 720° (equivalent to 0°), satisfying the &lt;strong&gt;Barkhausen criterion&lt;/strong&gt; for oscillation. The circuit initially settles at a metastable point (Vout ≈ Vcc/2) where all inverters are in their linear region. Small perturbations (noise, mismatch) cause the circuit to break away from this unstable equilibrium, and the oscillation amplitude grows until it reaches steady-state. The three outputs are phase-shifted by 120° from each other, making this circuit useful for generating &lt;strong&gt;three-phase signals&lt;/strong&gt;.&lt;/p&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card&quot; style=&quot;background-color: #e8f8f5; border-left: 4px solid #1abc9c;&quot;&gt;
        &lt;h2 style=&quot;color: #16a085;&quot;&gt;Key Characteristics &amp; Applications&lt;/h2&gt;
        &lt;ul style=&quot;line-height: 1.6; margin: 0;&quot;&gt;
            &lt;li&gt;&lt;strong&gt;Odd Number of Stages:&lt;/strong&gt; Required for oscillation (3, 5, 7... stages)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;RC Networks:&lt;/strong&gt; Control oscillation frequency and provide additional phase shift&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Metastable Startup:&lt;/strong&gt; Circuit needs perturbation to start oscillating&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Three-Phase Output:&lt;/strong&gt; 120° separation between outputs&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Applications:&lt;/strong&gt; Clock generation, three-phase signal generation, frequency references, PLL circuits, motor control signals&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Frequency Tuning:&lt;/strong&gt; Adjust R or C values to change oscillation frequency&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

&lt;/div&gt;"> 
    <!-- Parent container that responds to mouse movement -->
    <div class="chtool"> 
        
        <!-- tool bar-->
        <div class="ch-page-toolbar">
            <button class="ch-toolbar-button" title="Home" onclick="goHome()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3 L3 10 V21 H9 V15 H15 V21 H21 V10 Z"></path>
                </svg>
            </button>
            <button class="ch-toolbar-button" title="Modified" onclick="modifyAction()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
