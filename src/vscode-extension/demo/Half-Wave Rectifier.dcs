<g width="1500" height="1500" zoom="1.5999999999999994" left="0" top="0" symbol="{&quot;name&quot;:&quot;Half-Wave Rectifier&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;PyAMS&quot;,&quot;name&quot;:&quot;None&quot;},&quot;model&quot;:{&quot;name&quot;:&quot;None&quot;,&quot;file&quot;:&quot;None&quot;,&quot;dir&quot;:&quot;None&quot;,&quot;local&quot;:false,&quot;setParams&quot;:&quot;&quot;},&quot;description&quot;:{&quot;webPage&quot;:&quot;&quot;,&quot;info&quot;:&quot;&quot;}}"></g><polyline points="190,55 100,55 100,100 " class="polyline" name="net" xdir="false" ref="in" parent="true" parentcolor="false" used="true" id="0" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="null" setref="in"></polyline><polyline points="225,55 290,55 290,80 " class="polyline" name="net" xdir="false" ref="out" parent="true" parentcolor="false" used="true" id="1" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="null" setref="out"></polyline><polyline points="290,135 290,135 290,185 100,185 100,150 " class="polyline" name="net" xdir="false" ref="0" parent="false" parentcolor="false" used="true" id="2" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="false"></polyline><polyline points="235,195 235,185 235,185 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="3" node0="-1" node1="2" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><text class="draggable" name="text" x="24" y="21" r="0" rtemp="0" transform="rotate(0 24 21)" style="fill: rgb(255, 123, 0); font-weight: normal; font-style: normal; font-size: 12px; font-family: normal; stroke: rgb(0, 0, 0); stroke-width: 0.5;">Half-Wave Rectifier with Sinusoidal Source</text><text class="draggable" name="text" x="106" y="50" r="0" rtemp="0" transform="rotate(0 106  50)" style="fill: rgb(224, 41, 59); font-weight: bold; font-style: normal; font-size: 12px; font-family: bolder;">V(in)</text><text class="draggable" name="text" x="256" y="51" r="0" rtemp="0" transform="rotate(0 256 51)" style="fill: rgb(0, 42, 255); font-weight: bolder; font-style: normal; font-size: 12px; font-family: bold;">V(out)</text><g transform="translate(403,7)" x="403" y="7" title="codeHTML" width="414" height="572" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="222" height="200" style="height: 572px; width: 690px;"><div name="htmlCode" style="zoom: 60%; height: 572px; width: 690px;" code="&lt;div class=&quot;ch&quot;&gt;
    
    &lt;h1&gt;Half-Wave Rectifier with Sinusoidal Source - SPICE Time Domain Analysis&lt;/h1&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Circuit Components&lt;/h2&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;V1:&lt;/strong&gt; Sinusoidal Voltage Source SIN(0 10 50)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;D1:&lt;/strong&gt; 1N4001 Diode (rectifier)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;R1:&lt;/strong&gt; 1 kΩ (load resistor)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Analysis Type:&lt;/strong&gt; Time Domain (0s to 0.12s)&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

    &lt;h2&gt;Input Signal Parameters&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        SIN(Voffset Vamplitude Frequency) = SIN(0 10 50)&lt;br&gt;
        • DC Offset = 0V&lt;br&gt;
        • Peak Amplitude = 10V&lt;br&gt;
        • Frequency = 50 Hz (Period = 20ms)&lt;br&gt;
        • RMS Voltage = 10/√2 ≈ &lt;strong&gt;7.07V&lt;/strong&gt;
    &lt;/div&gt;

    &lt;h2&gt;Simulation Results&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;

        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Input Signal V(in) - Red&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;Full sinusoidal waveform&lt;/li&gt;
                &lt;li&gt;Swings between +10V and -10V&lt;/li&gt;
                &lt;li&gt;Frequency: 50 Hz (6 complete cycles in 0.12s)&lt;/li&gt;
                &lt;li&gt;Period: 20 ms per cycle&lt;/li&gt;
                &lt;li&gt;AC signal with zero DC component&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;Output Signal V(out) - Blue&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;Only positive half-cycles appear at output&lt;/li&gt;
                &lt;li&gt;Negative half-cycles are blocked (clipped to 0V)&lt;/li&gt;
                &lt;li&gt;Peak output ≈ 10V (minus diode drop ~0.7V)&lt;/li&gt;
                &lt;li&gt;Pulsating DC output (unidirectional)&lt;/li&gt;
                &lt;li&gt;Output frequency = Input frequency (50 Hz)&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

    &lt;/div&gt;

    &lt;div class=&quot;ch-card green-border&quot;&gt;
        &lt;h2&gt;Conclusion&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;This circuit is a &lt;strong&gt;Half-Wave Rectifier&lt;/strong&gt; that converts AC input to pulsating DC output. During the positive half-cycle of the input, the diode (D1) is forward-biased and conducts, allowing current to flow through R1. During the negative half-cycle, the diode is reverse-biased and blocks current, resulting in zero output voltage. The output contains only the positive portions of the input waveform, creating a unidirectional but pulsating DC signal. The 1N4001 diode introduces a small voltage drop (~0.7V), so the actual peak output is approximately 9.3V.&lt;/p&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card&quot; style=&quot;background-color: #e8f8f5; border-left: 4px solid #1abc9c;&quot;&gt;
        &lt;h2 style=&quot;color: #16a085;&quot;&gt;Key Characteristics &amp; Applications&lt;/h2&gt;
        &lt;ul style=&quot;line-height: 1.6; margin: 0;&quot;&gt;
            &lt;li&gt;&lt;strong&gt;Rectification Efficiency:&lt;/strong&gt; ~40.6% (low compared to full-wave)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Ripple Factor:&lt;/strong&gt; High (1.21) - requires filtering for smooth DC&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;DC Output Voltage:&lt;/strong&gt; Vdc = Vpeak/π ≈ 3.18V (ideal)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Applications:&lt;/strong&gt; Simple power supplies, signal demodulation, peak detection&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Limitation:&lt;/strong&gt; Uses only 50% of input waveform (inefficient)&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

&lt;/div&gt;"><div class="ch">
    
    <h1>Half-Wave Rectifier with Sinusoidal Source - SPICE Time Domain Analysis</h1>

    <div class="ch-card">
        <h2>Circuit Components</h2>
        <ul>
            <li><strong>V1:</strong> Sinusoidal Voltage Source SIN(0 10 50)</li>
            <li><strong>D1:</strong> 1N4001 Diode (rectifier)</li>
            <li><strong>R1:</strong> 1 kΩ (load resistor)</li>
            <li><strong>Analysis Type:</strong> Time Domain (0s to 0.12s)</li>
        </ul>
    </div>

    <h2>Input Signal Parameters</h2>
    <div class="ch-formula">
        SIN(Voffset Vamplitude Frequency) = SIN(0 10 50)<br>
        • DC Offset = 0V<br>
        • Peak Amplitude = 10V<br>
        • Frequency = 50 Hz (Period = 20ms)<br>
        • RMS Voltage = 10/√2 ≈ <strong>7.07V</strong>
    </div>

    <h2>Simulation Results</h2>
    <div class="ch-grid">

        <div class="ch-col blue">
            <h3>Input Signal V(in) - Red</h3>
            <ul>
                <li>Full sinusoidal waveform</li>
                <li>Swings between +10V and -10V</li>
                <li>Frequency: 50 Hz (6 complete cycles in 0.12s)</li>
                <li>Period: 20 ms per cycle</li>
                <li>AC signal with zero DC component</li>
            </ul>
        </div>

        <div class="ch-col red">
            <h3>Output Signal V(out) - Blue</h3>
            <ul>
                <li>Only positive half-cycles appear at output</li>
                <li>Negative half-cycles are blocked (clipped to 0V)</li>
                <li>Peak output ≈ 10V (minus diode drop ~0.7V)</li>
                <li>Pulsating DC output (unidirectional)</li>
                <li>Output frequency = Input frequency (50 Hz)</li>
            </ul>
        </div>

    </div>

    <div class="ch-card green-border">
        <h2>Conclusion</h2>
        <p style="line-height: 1.6; margin: 0;">This circuit is a <strong>Half-Wave Rectifier</strong> that converts AC input to pulsating DC output. During the positive half-cycle of the input, the diode (D1) is forward-biased and conducts, allowing current to flow through R1. During the negative half-cycle, the diode is reverse-biased and blocks current, resulting in zero output voltage. The output contains only the positive portions of the input waveform, creating a unidirectional but pulsating DC signal. The 1N4001 diode introduces a small voltage drop (~0.7V), so the actual peak output is approximately 9.3V.</p>
    </div>

    <div class="ch-card" style="background-color: #e8f8f5; border-left: 4px solid #1abc9c;">
        <h2 style="color: #16a085;">Key Characteristics &amp; Applications</h2>
        <ul style="line-height: 1.6; margin: 0;">
            <li><strong>Rectification Efficiency:</strong> ~40.6% (low compared to full-wave)</li>
            <li><strong>Ripple Factor:</strong> High (1.21) - requires filtering for smooth DC</li>
            <li><strong>DC Output Voltage:</strong> Vdc = Vpeak/π ≈ 3.18V (ideal)</li>
            <li><strong>Applications:</strong> Simple power supplies, signal demodulation, peak detection</li>
            <li><strong>Limitation:</strong> Uses only 50% of input waveform (inefficient)</li>
        </ul>
    </div>

</div></div></foreignObject></g><g x="275" y="75" transform="translate(275,75)" width="25" height="60" class="part" name="part" xo="0" yo="0" sref="R1" directory="Basic"><g width="350" height="350" zoom="10.799999999999992" left="342" top="142" symbol="{&quot;name&quot;:&quot;Resistor&quot;,&quot;reference&quot;:&quot;R&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;SPICE&quot;,&quot;name&quot;:&quot;Resistor&quot;},&quot;model&quot;:{&quot;name&quot;:&quot;Resistor&quot;,&quot;file&quot;:&quot;Resistor.py&quot;,&quot;dir&quot;:&quot;library&quot;,&quot;local&quot;:true,&quot;setParams&quot;:&quot;R=100Ω&quot;},&quot;description&quot;:{&quot;webPage&quot;:&quot;&quot;,&quot;info&quot;:&quot;&quot;}}"></g><g points="15,5 15,15" class="polyline" name="pin" type="simple" netid="1" netidpos="2" netId="1" netIdPos="2"><polyline points="15,5 15,15 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="17" transform="rotate(90 13 17)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none; fill: rgb(0, 0, 0);">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">+</text><ellipse cx="15" cy="13.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,15 16.5,15 15,16.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><g points="15,60 15,50" class="polyline" name="pin" type="simple" netid="2" netidpos="0" netId="2" netIdPos="0"><polyline points="15,60 15,50 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="57" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><tex