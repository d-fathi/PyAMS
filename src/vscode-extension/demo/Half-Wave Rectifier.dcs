d="0" netIdPos="2"><polyline points="20,5 20,15 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="17" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="18" y="17" transform="rotate(90 18 17)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="20" y="5" transform="rotate(0 20 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">+</text><ellipse cx="20" cy="13.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="18.5,15 21.5,15 20,16.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><g points="20,55 20,45" class="polyline" name="pin" type="simple" netid="2" netidpos="4" netId="2" netIdPos="4"><polyline points="20,55 20,45 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="17" y="52" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="18" y="43" transform="rotate(90 18 43)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">n</text><text r="0" x="20" y="55" transform="rotate(0 20 55)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">-</text><ellipse cx="20" cy="46.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="18.5,45 21.5,45 20,43.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><text class="var" name="ref" x="36" y="30" r="0" transform="rotate(0 36 30)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">V1</text><text class="var" name="param" x="36" y="41" r="0" transform="rotate(0 36 41)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;" show="Name and value" paramvalue="10V" paramname="Va">Va=10V</text><ellipse class="draggable" name="ellipse" cx="20" cy="30" rx="15" ry="15" style="stroke: rgb(33, 150, 243); fill: rgb(255, 255, 127); stroke-width: 1px; filter: drop-shadow(rgba(0, 0, 0, 0.5) 2px 2px 4px);"></ellipse><polyline points="22,19 18,19 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="20,21 20,17 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><path class="arc" name="arc" d="M 28 31 A 4 5 0 0 1 20 31.000000000000004" cx="24" cy="31" rx="4" ry="5" startangle="6.283185307179586" deltaangle="3.141592653589793" endangle="3.141592653589793" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;" r="1" h="1" v="1"></path><path class="arc" name="arc" d="M 12 31.000000000000004 A 4 5 0 0 1 20 30.999999999999996" cx="16" cy="31" rx="4" ry="5" startangle="9.42477796076938" deltaangle="3.141592653589793" endangle="3.141592653589793" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;" r="1" h="1" v="1"></path><text class="var" name="param" x="37" y="50" r="0" transform="rotate(0 37 50)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;" show="Name and value" paramvalue="2Hz" paramname="Fr">Fr=2Hz</text></g><g x="185" y="40" transform="translate(185,40)" width="40" height="25" class="part" name="part" xo="0" yo="0" sref="D1" directory="Semiconductor"><g width="350" height="350" zoom="7.600000000000001" left="0" top="0" symbol="{&quot;name&quot;:&quot;Diode&quot;,&quot;reference&quot;:&quot;D&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;PyAMS&quot;,&quot;name&quot;:&quot;None&quot;},&quot;model&quot;:{&quot;name&quot;:&quot;Diode&quot;,&quot;file&quot;:&quot;Diode.py&quot;,&quot;dir&quot;:&quot;library&qu