<g width="1500" height="1500" zoom="1.9999999999999993" left="21" top="0" symbol="{&quot;name&quot;:&quot;filter&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;PyAMS&quot;,&quot;name&quot;:&quot;None&quot;},&quot;model&quot;:{&quot;name&quot;:&quot;None&quot;,&quot;file&quot;:&quot;None&quot;,&quot;dir&quot;:&quot;None&quot;,&quot;local&quot;:false,&quot;setParams&quot;:&quot;&quot;},&quot;description&quot;:{&quot;webPage&quot;:&quot;&quot;,&quot;info&quot;:&quot;&quot;}}"></g><polyline points="80,40 55,40 55,55 " class="polyline" name="net" xdir="false" ref="in" parent="true" parentcolor="false" used="true" id="0" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="null" setref="in"></polyline><polyline points="135,40 165,40 " class="polyline" name="net" xdir="false" ref="N02" parent="false" parentcolor="false" used="true" id="1" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="215,40 245,40 245,40 275,40 " class="polyline" name="net" xdir="false" ref="N03" parent="false" parentcolor="false" used="true" id="2" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="false"></polyline><polyline points="325,40 355,40 355,50 " class="polyline" name="net" xdir="false" ref="out" parent="true" parentcolor="false" used="true" id="3" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="null" setref="out"></polyline><polyline points="55,105 55,120 355,120 355,105 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="4" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="245,95 245,120 245,120 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="5" node0="-1" node1="4" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="false"></polyline><polyline points="200,135 200,120 200,120 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="6" node0="-1" node1="4" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="false"></polyline><text class="draggable" name="text" x="60" y="33" r="0" rtemp="0" transform="rotate(0 60 33)" style="fill: rgb(255, 123, 0); font-weight: bold; font-style: normal; font-size: 13px; font-family: normal;">in</text><text class="draggable" name="text" x="330" y="33" r="0" rtemp="0" transform="rotate(0 330 33)" style="fill: rgb(255, 123, 0); font-weight: bold; font-style: normal; font-size: 13px; font-family: normal;">out</text><g transform="translate(438,25)" x="438" y="25" title="codeHTML" width="321" height="376" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="321" height="376" style="height: 376px; width: 321px;"><div name="htmlCode" style="zoom: 0.321; height: 1171.34px; width: 1000px;" code="&lt;div class=&quot;ch&quot;&gt;
    &lt;h1&gt;3rd-Order Chebyshev Low-Pass Filter - PyAMS AC Analysis&lt;/h1&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Circuit Specifications&lt;/h2&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;Filter Type:&lt;/strong&gt; 3rd-Order Chebyshev Type I (T-Network LC Ladder)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Cutoff Frequency (fc):&lt;/strong&gt; 1000 Hz (1 kHz)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Passband Ripple:&lt;/strong&gt; 0.5 dB&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Characteristic Impedance (Z0):&lt;/strong&gt; 100 &amp;Omega;&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Source Resistor (Rs):&lt;/strong&gt; 100 &amp;Omega;&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Load Resistor (RL):&lt;/strong&gt; 100 &amp;Omega;&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Inductor 1 (L1):&lt;/strong&gt; 25.4 mH&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Capacitor 1 (C1):&lt;/strong&gt; 1.75 &amp;micro;F&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Inductor 2 (L2):&lt;/strong&gt; 25.4 mH&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Input (V1):&lt;/strong&gt; AC Voltage Source (1V amplitude)&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

    &lt;h2&gt;Chebyshev Polynomial &amp;amp; Transfer Function&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        |H(j&amp;omega;)|&amp;sup2; = 1 / [1 + &amp;epsilon;&amp;sup2; &amp;middot; T&amp;sup2;&amp;#8323;(&amp;omega;/&amp;omega;c)]&lt;br&gt;
        T&amp;#8323;(x) = 4x&amp;sup3; &amp;minus; 3x &amp;nbsp;&amp;nbsp;(for n = 3)&lt;br&gt;
        Ripple parameter: &amp;epsilon; = &amp;radic;(10^(0.1&amp;middot;R_dB) &amp;minus; 1) = &amp;radic;(10^0.05 &amp;minus; 1) &amp;approx; &lt;strong&gt;0.3493&lt;/strong&gt;
    &lt;/div&gt;

    &lt;h2&gt;Normalized Prototype Values (g-parameters)&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        g&amp;#8321; = 1.5963 (L1) &amp;rarr; L1 = (g&amp;#8321; &amp;middot; Z0) / (2&amp;pi;fc) = (1.5963 &amp;times; 100) / 6283.185 &amp;approx; &lt;strong&gt;25.4 mH&lt;/strong&gt;&lt;br&gt;
        g&amp;#8322; = 1.0967 (C1) &amp;rarr; C1 = g&amp;#8322; / (2&amp;pi;fc &amp;middot; Z0) = 1.0967 / (6283.185 &amp;times; 100) &amp;approx; &lt;strong&gt;1.75 &amp;micro;F&lt;/strong&gt;&lt;br&gt;
        g&amp;#8323; = 1.5963 (L2) &amp;rarr; L2 = (g&amp;#8323; &amp;middot; Z0) / (2&amp;pi;fc) = (1.5963 &amp;times; 100) / 6283.185 &amp;approx; &lt;strong&gt;25.4 mH&lt;/strong&gt;
    &lt;/div&gt;

    &lt;h2&gt;Simulation &amp;amp; Response Characteristics&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;
        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Magnitude Response (dB)&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Passband (f &amp;lt; 1 kHz):&lt;/strong&gt; Equiripple behavior within 0.5 dB band&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Insertion Loss:&lt;/strong&gt; -6 dB baseline due to matched 100 &amp;Omega; source and load termination&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Cutoff (1 kHz):&lt;/strong&gt; Reaches -6.5 dB (0.5 dB below peak)&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Stopband Roll-off:&lt;/strong&gt; Steep -60 dB/decade (-18 dB/octave) slope&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Attenuation at 3 kHz:&lt;/strong&gt; &amp;gt; 32 dB attenuation&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Attenuation at 10 kHz:&lt;/strong&gt; &amp;gt; 62 dB attenuation&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;Phase &amp;amp; Group Delay&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Low Frequency:&lt;/strong&gt; Nearly linear phase near 0&amp;deg;&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;At Cutoff (1 kHz):&lt;/strong&gt; Phase shift around -135&amp;deg;&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Stopband (f &amp;gt; 3 kHz):&lt;/strong&gt; Phase approaches asymptotic transition&lt;/li&gt;
                &lt;li&gt;Higher selectivity achieved compared to Butterworth of identical order&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card green-border&quot;&gt;
        &lt;h2&gt;Conclusion &amp;amp; Applications&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;Chebyshev Type I filters provide a significantly &lt;strong&gt;steeper transition&lt;/strong&gt; between the passband and stopband than Butterworth or Bessel filters of the same order, at the expense of controlled ripple in the passband. This makes them ideal for RF front-ends, channel selection in communications systems, audio crossover networks, and anti-aliasing pre-filters where sharp out-of-band rejection is critical.&lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;"> 
    <!-- Parent container that responds to mouse movement -->
    <div class="chtool"> 
        
        <!-- tool bar-->
        <div class="ch-page-toolbar" style="zoom: 3.11526;">
            <button class="ch-toolbar-button" title="Home">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3 L3 10 V21 H9 V15 H15 V21 H21 V10 Z"></path>
                </svg>
            </button>
            <button class="ch-toolbar-button" title="Modified" onclick="modifyAction()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
                </svg>
