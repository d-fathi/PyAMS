<g width="1500" height="1500" zoom="1.9999999999999993" left="21" top="0" symbol="{&quot;name&quot;:&quot;AC Sample Analysis&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;SPICE&quot;,&quot;name&quot;:&quot;None&quot;},&quot;model&quot;:{&quot;name&quot;:&quot;None&quot;,&quot;file&quot;:&quot;None&quot;,&quot;dir&quot;:&quot;None&quot;,&quot;local&quot;:false},&quot;description&quot;:{&quot;webPage&quot;:&quot;&quot;,&quot;info&quot;:&quot;&quot;}}"></g><polyline points="195,35 250,35 250,65 " class="polyline" name="net" xdir="false" ref="out" parent="true" parentcolor="false" used="true" id="0" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="null" setref="out"></polyline><polyline points="140,35 85,35 85,55 " class="polyline" name="net" xdir="false" ref="in" parent="true" parentcolor="false" used="true" id="1" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="null" setref="in"></polyline><polyline points="85,105 85,125 250,125 250,95 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="2" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="150,135 150,125 150,125 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="3" node0="-1" node1="2" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="false"></polyline><text class="draggable" name="text" x="215" y="32" r="0" rtemp="0" transform="rotate(0 215 32)" style="fill: rgb(255, 123, 0); font-weight: bold; font-style: normal; font-size: 13px; font-family: normal;">out</text><text class="draggable" name="text" x="95" y="32" r="0" rtemp="0" transform="rotate(0 95 32)" style="fill: rgb(255, 123, 0); font-weight: bold; font-style: normal; font-size: 13px; font-family: normal;">in</text><g transform="translate(390,3)" x="390" y="3" title="codeHTML" width="457" height="489" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="222" height="200" style="height: 489px; width: 761.667px;"><div name="htmlCode" style="zoom: 60%; height: 489px; width: 761.667px;" code="&lt;div class=&quot;ch&quot;&gt;
    
    &lt;h1&gt;RC Low-Pass Filter - SPICE AC Analysis&lt;/h1&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Circuit Components&lt;/h2&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;Resistor (R1):&lt;/strong&gt; 1 k&amp;Omega;&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Capacitor (C1):&lt;/strong&gt; 1 &amp;micro;F&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Input (V1):&lt;/strong&gt; AC Voltage Source (1V amplitude)&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

    &lt;h2&gt;Cutoff Frequency&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        fc = 1 / (2&amp;pi;RC) = 1 / (2&amp;pi; &amp;times; 1000 &amp;times; 1&amp;times;10&amp;minus;6) &amp;approx; &lt;strong&gt;159 Hz&lt;/strong&gt;
    &lt;/div&gt;

    &lt;h2&gt;Simulation Results&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;

        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Magnitude Response (Black Line)&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Pass Band:&lt;/strong&gt; 0 dB gain for f &amp;lt; 159 Hz&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Cutoff Point:&lt;/strong&gt; -3 dB drop at 159 Hz&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Stop Band:&lt;/strong&gt; -20 dB/decade roll-off&lt;/li&gt;
                &lt;li&gt;At 10 kHz, attenuation is approx -35 dB&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;Phase Response (Red Line)&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Low Freq:&lt;/strong&gt; 0&amp;deg; phase shift&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;At Cutoff (fc):&lt;/strong&gt; -45&amp;deg; (-0.785 rad)&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;High Freq:&lt;/strong&gt; Approaches -90&amp;deg; (-&amp;pi;/2 rad)&lt;/li&gt;
                &lt;li&gt;Capacitor introduces a lagging phase shift&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

    &lt;/div&gt;

    &lt;div class=&quot;ch-card green-border&quot;&gt;
        &lt;h2&gt;Conclusion&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;The circuit functions perfectly as a &lt;strong&gt;low-pass filter&lt;/strong&gt;. It allows low-frequency signals (below 159 Hz) to pass with minimal loss while heavily attenuating high-frequency signals. The simulation results align exactly with theoretical calculations.&lt;/p&gt;
    &lt;/div&gt;

&lt;/div&gt;"> 
    <!-- Parent container that responds to mouse movement -->
    <div class="chtool"> 
        
        <!-- tool bar-->
        <div class="ch-page-toolbar">
            <button class="ch-toolbar-button" title="Home" onclick="goHome()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3 L3 10 V21 H9 V15 H15 V21 H21 V10 Z"></path>
                </svg>
            </button>
            <button class="ch-toolbar-button" title="Modified" onclick="modifyAction()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
                </svg>
            </button>
        </div>

       <div class="ch">
    
    <h1>RC Low-Pass Filter - SPICE AC Analysis</h1>

    <div class="ch-card">
        <h2>Circuit Components</h2>
        <ul>
            <li><strong>Resistor (R1):</strong> 1 kΩ</li>
            <li><strong>Capacitor (C1):</strong> 1 µF</li>
            <li><strong>Input (V1):</strong> AC Voltage Source (1V amplitude)</li>
        </ul>
    </div>

    <h2>Cutoff Frequency</h2>
    <div class="ch-formula">
        fc = 1 / (2πRC) = 1 / (2π × 1000 × 1×10−6) ≈ <strong>159 Hz</strong>
    </div>

    <h2>Simulation Results</h2>
    <div class="ch-grid">

        <div class="ch-col blue">
            <h3>Magnitude Response (Black Line)</h3>
            <ul>
                <li><strong>Pass Band:</strong> 0 dB gain for f &lt; 159 Hz</li>
                <li><strong>Cutoff Point:</strong> -3 dB drop at 159 Hz</li>
                <li><strong>Stop Band:</strong> -20 dB/decade roll-off</li>
                <li>At 10 kHz, attenuation is approx -35 dB</li>
            </ul>
        </div>

        <div class="ch-col red">
            <h3>Phase Response (Red Line)</h3>
            <ul>
                <li><strong>Low Freq:</strong> 0° phase shift</li>
                <li><strong>At Cutoff (fc):</strong> -45° (-0.785 rad)</li>
                <li><strong>High Freq:</strong> Approaches -90° (-π/2 rad)</li>
                <li>Capacitor introduces a lagging phase shift</li>
            </ul>
        </div>

    </div>

    <div class="ch-card green-border">
        <h2>Conclusion</h2>
        <p style="line-height: 1.6; margin: 0;">The circuit functions perfectly as a <strong>low-pass filter</strong>. It allows low-frequency signals (below 159 Hz) to pass with minimal loss while heavily attenuating high-frequency signals. The simulation results align exactly with theoretical calculations.</p>
    </div>

</div>
    </div>
    </div></foreignObject></g><g x="135" y="130" transform="translate(135,130)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X1" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="3" netidpos="0" netId="3" netIdPos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline></g><g x="135" y="20" transform="translate(135,20)" width="60" height="25" class="part" name="part" xo="0" yo="0" sref="R1" directory="Basic"><g width="350" height="350" zoom="10.799999999999992" left="342" top="142" symbol="{&quot;name&quot;:&quot;Resistor&quot;,&