9&quot;},&quot;description&quot;:{&quot;webPage&quot;:&quot;&quot;,&quot;info&quot;:&quot;Red light emitting diode (Vf = 1.9 V at 10 mA). The triangle is a live segment: it lights up when the current exceeds half of Iref (parameter lit of the model LED). Needs a series resistor.&quot;}}"></g><polygon points="20,15 20,35 40,25 " class="draggable" name="polygon" wlive="1" wref="led" wcfg="{&quot;onColor&quot;:&quot;#ef4444&quot;,&quot;offColor&quot;:&quot;#4b2a2a&quot;,&quot;threshold&quot;:0.5,&quot;activeLow&quot;:false,&quot;value&quot;:0,&quot;scale&quot;:1,&quot;offset&quot;:0}" wbind="param:lit" style="stroke: rgb(33, 150, 243); fill: #4b2a2a; stroke-width: 1px;"></polygon><polyline points="40,15 40,35 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="43,11 51,3 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="51,3 46,3 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="51,3 51,8 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="49,15 57,7 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="57,7 52,7 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="57,7 57,12 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><g points="5,25 20,25" class="polyline" name="pin" type="simple" netId="28" netIdPos="1"><polyline points="5,25 20,25 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="2" y="22" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0