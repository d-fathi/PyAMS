50" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="4" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><g x="265" y="110" transform="translate(265,110)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X1" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="5" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><text class="draggable" name="text" x="40" y="18" r="0" rtemp="0" transform="rotate(0 40 18)" style="fill: rgb(255, 123, 0); font-weight: normal; font-style: italic; font-size: 14px; font-family: lighter;">RC charge / discharge with an SPDT switch (Live simulation)</text><text class="draggable" name="text" x="40" y="30" r="0" rtemp="0" transform="rotate(0 40 30)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">Click the switch: upper = charge, lower = discharge.</text><g name="liveScope" class="liveScope" x="470" y="50" width="300" height="200" transform="translate(470,50)" scope="{&quot;mode&quot;:&quot;YT&quot;,&quot;timeDiv&quot;:0.1,&quot;trigger&quot;:{&quot;mode&quot;:&quot;off&quot;,&quot;source&quot;:0,&quot;level&quot;:0,&quot;edge&quot;:&quot;rise&quot;},&quot;grid&quot;:true,&quot;labels&quot;:true,&quot;dark&quot;:true,&quot;lineWidth&quot;:1.5,&quot;channels&quot;:[{&quot;on&quot;:true,&quot;signal&quot;:&quot;vc&quot;,&quot;kind&quot;:&quot;voltage&quot;,&quot;color&quot;:&quot;#3b82f6&quot;,&quot;vdiv&quot;:2,&quot;offset&quot;:0,&quot;invert&quot;:false},{&quot;on&quot;:true,&quot;signal&quot;:&quot;com&quot;,&quot;kind&quot;:&quot;voltage&quot;,&quot;color&quot;:&quot;#f59e0b&quot;,&quot;vdiv&quot;:2,&quot;offset&quot;:0,&quot;invert&quot;:false}]}"><foreignObject x="0" y="0" width="300" height="200"><canvas class="liveScopeCanvas" style="width: 300px; height: 200px; display: block;"></canvas></foreignObject></g><g transform="translate(40,280)" x="40" y="280" title="codeHTML" width="730" height="759" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="730" height="759" style="width: 730px; height: 759px;"><div name="htmlCode" style="zoom: 0.73; height: 1039.73px; width: 1000px;" code="&lt;div class=&quot;ch&quot;&gt;
&lt;h1&gt;RC Charge / Discharge with an SPDT Switch&lt;/h1&gt;

&lt;div class=&quot;ch-card&quot;&gt;
&lt;h2&gt;Circuit Components&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Source (V1):&lt;/strong&gt; DC voltage source, 10 V&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Switch (SW1):&lt;/strong&gt; SPDT manual switch. &lt;em&gt;com&lt;/em&gt; goes to R1, &lt;em&gt;no&lt;/em&gt; (upper position) to V1, &lt;em&gt;nc&lt;/em&gt; (lower position) to ground&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Resistor (R1):&lt;/strong&gt; 1 k&amp;Omega;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Capacitor (C1):&lt;/strong&gt; 100 &amp;micro;F, initially discharged&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;

&lt;h2&gt;Time Constant&lt;/h2&gt;
&lt;div class=&quot;ch-formula&quot;&gt;
$\tau = R_1 C_1 = 1000\ \Omega \times 100\ \mu F = \mathbf{0.1\ s}$ &amp;nbsp;&amp;nbsp; ($5\tau = 0.5\ s$)
&lt;/div&gt;

&lt;h2&gt;The Two Positions&lt;/h2&gt;
&lt;div class=&quot;ch-grid&quot;&gt;
&lt;div class=&quot;ch-col blue&quot;&gt;
&lt;h3&gt;Upper position (no): charging&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;V1 charges C1 through R1&lt;/li&gt;
&lt;li&gt;$v_c(t) = V_1\left(1 - e^{-t/\tau}\right)$&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;At $\tau$:&lt;/strong&gt; 63.2 % of V1 (6.32 V)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;At $3\tau$:&lt;/strong&gt; 95.0 % (9.50 V)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;At $5\tau$:&lt;/strong&gt; 99.3 % (9.93 V), practically 10 V&lt;/li&gt;
&lt;li&gt;The current starts at $V_1/R_1 = 10\ mA$ and decays to 0&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class=&quot;ch-col red&quot;&gt;
&lt;h3&gt;Lower position (nc): discharging&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;C1 discharges through R1 to ground&lt;/li&gt;
&lt;li&gt;$v_c(t) = V_0\, e^{-t/\tau}$ where $V_0$ is the voltage when the switch was thrown&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;At $\tau$:&lt;/strong&gt; 36.8 % of V0&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;At $3\tau$:&lt;/strong&gt; 5.0 % of V0&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;At $5\tau$:&lt;/strong&gt; 0.7 % of V0, practically 0 V&lt;/li&gt;
&lt;li&gt;The current reverses: it flows out of C1 through R1&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;/div&gt;

&lt;h2&gt;How to Run It&lt;/h2&gt;
&lt;div class=&quot;ch-card&quot;&gt;
&lt;ol&gt;
&lt;li&gt;Open the Live panel and press &lt;strong&gt;Run&lt;/strong&gt; (speed: Real time).&lt;/li&gt;
&lt;li&gt;Click the switch to move it to the upper position: &lt;em&gt;vc&lt;/em&gt; (blue) rises to 10 V.&lt;/li&gt;
&lt;li&gt;Wait about 0.5 s, then click again: &lt;em&gt;vc&lt;/em&gt; falls back to 0 V.&lt;/li&gt;
&lt;li&gt;Switch before C1 is full (for example after 0.1 s) and see that the discharge starts from 6.3 V, not from 10 V.&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;The scope shows &lt;em&gt;vc&lt;/em&gt; (blue, voltage across C1) and &lt;em&gt;com&lt;/em&gt; (orange, the switch output: 10 V in the upper position, 0 V in the lower one). While C1 charges, the gap between the two curves is the voltage across R1.&lt;/p&gt;
&lt;/div&gt;

&lt;div class=&quot;ch-card green-border&quot;&gt;
&lt;h2&gt;Conclusion&lt;/h2&gt;
&lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;The SPDT switch gives the capacitor a source &lt;strong&gt;or&lt;/strong&gt; a ground, so C1 charges to the full 10 V and then discharges completely. Both transients are exponential with the same time constant $\tau = R_1 C_1 = 0.1\ s$, as in the theory.&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
"> 
    <!-- Parent container that responds to mouse movement -->
    <div class="chtool"> 
        
        <!-- tool bar-->
        <div class="ch-page-toolbar" style="zoom: 1.36986;">
