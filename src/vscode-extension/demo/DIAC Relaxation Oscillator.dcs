<g width="1500" height="1500" zoom="1.7999999999999994" left="83" top="0" symbol="{&quot;name&quot;:&quot;DIAC Relaxation Oscillator&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;PyAMS&quot;,&quot;name&quot;:&quot;None&quot;},&quot;model&quot;:{&quot;name&quot;:&quot;None&quot;,&quot;file&quot;:&quot;None&quot;,&quot;dir&quot;:&quot;None&quot;,&quot;local&quot;:false,&quot;setParams&quot;:&quot;&quot;},&quot;description&quot;:{&quot;webPage&quot;:&quot;&quot;,&quot;info&quot;:&quot;&quot;}}"></g><polyline points="190,65 325,65 325,75 " class="polyline" name="net" xdir="false" ref="out1" parent="true" parentcolor="false" used="true" id="0" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="null" setref="out1"></polyline><polyline points="325,145 325,110 325,110 " class="polyline" name="net" xdir="true" ref="out2" parent="false" parentcolor="false" used="true" id="1" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="135,65 110,65 110,110 " class="polyline" name="net" xdir="false" ref="N03" parent="false" parentcolor="false" used="true" id="2" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="false"></polyline><polyline points="230,110 230,65 230,65 " class="polyline" name="net" xdir="true" ref="out1" parent="false" parentcolor="false" used="true" id="3" node0="-1" node1="0" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="110,145 110,180 110,180 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="4" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="230,140 230,175 230,175 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="5" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="325,200 325,205 325,205 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="6" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="325,130 325,130 380,130 " class="polyline" name="net" xdir="true" ref="out2" parent="true" parentcolor="false" used="true" id="7" node0="1" node1="-1" diagonal="false" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" setref="out2"></polyline><polyline points="325,65 325,65 380,65 " class="polyline" name="net" xdir="true" ref="out1" parent="false" parentcolor="false" used="true" id="8" node0="0" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><g transform="translate(470,36)" x="470" y="36" title="codeHTML" width="442" height="747" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="222" height="200" style="height: 747px; width: 736.667px;"><div name="htmlCode" style="zoom: 60%; height: 747px; width: 736.667px;" code="&lt;div class=&quot;ch&quot;&gt;
    
    &lt;h1&gt;DIAC Relaxation Oscillator - PyAMS Time Domain Analysis&lt;/h1&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Circuit Components&lt;/h2&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;V1:&lt;/strong&gt; DC Voltage Source = 60V&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;R1:&lt;/strong&gt; 100 kΩ (charging resistor)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;C1:&lt;/strong&gt; 22 nF (timing capacitor)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;D1:&lt;/strong&gt; DIAC (bidirectional trigger diode)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;R2:&lt;/strong&gt; 10 Ω (discharge/load resistor)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Analysis Type:&lt;/strong&gt; Time Domain (0s to 8ms)&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

    &lt;h2&gt;Time Constant &amp; Operating Principle&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        τ = R1 × C1 = 100kΩ × 22nF = &lt;strong&gt;2.2 ms&lt;/strong&gt;&lt;br&gt;
        DIAC Breakover Voltage (VBO) ≈ &lt;strong&gt;30-35V&lt;/strong&gt; (typical)&lt;br&gt;
        The capacitor charges through R1 until V(BO) is reached, then DIAC fires
    &lt;/div&gt;

    &lt;h2&gt;Simulation Results&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;

        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Capacitor Voltage V(out1) - Blue&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Sawtooth waveform&lt;/strong&gt; with exponential charging curve&lt;/li&gt;
                &lt;li&gt;Charges from ~16V up to ~35V (DIAC breakover voltage)&lt;/li&gt;
                &lt;li&gt;Sharp discharge when DIAC triggers&lt;/li&gt;
                &lt;li&gt;Period ≈ 1.5 ms (frequency ≈ 670 Hz)&lt;/li&gt;
                &lt;li&gt;Peak voltage matches DIAC breakover threshold&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;Output Pulses V(out2) - Red&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Short positive pulses&lt;/strong&gt; at each DIAC firing&lt;/li&gt;
                &lt;li&gt;Pulse amplitude: ~5V across R2&lt;/li&gt;
                &lt;li&gt;Pulse width: very narrow (fast discharge through 10Ω)&lt;/li&gt;
                &lt;li&gt;One pulse per oscillation cycle&lt;/li&gt;
                &lt;li&gt;Represents the trigger output signal&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

    &lt;/div&gt;

    &lt;div class=&quot;ch-card green-border&quot;&gt;
        &lt;h2&gt;Conclusion&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;This circuit is a &lt;strong&gt;DIAC Relaxation Oscillator&lt;/strong&gt; that generates periodic trigger pulses. The capacitor C1 charges exponentially through R1 from the 60V supply. When the capacitor voltage reaches the DIAC's breakover voltage (~30-35V), the DIAC switches from high impedance to low impedance state, causing rapid discharge of C1 through R2. This produces a sharp voltage pulse across R2 (V(out2)) and drops the capacitor voltage to a low value (~16V). The cycle then repeats as C1 begins charging again. The result is a &lt;strong&gt;sawtooth waveform&lt;/strong&gt; at the capacitor and &lt;strong&gt;periodic trigger pulses&lt;/strong&gt; at the output. This circuit is commonly used as a trigger generator for TRIACs in AC power control applications like dimmers and motor speed controllers.&lt;/p&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card&quot; &gt;
        &lt;h2 style=&quot;color: #16a085;&quot;&gt;DIAC Characteristics &amp; Applications&lt;/h2&gt;
        &lt;ul style=&quot;line-height: 1.6; margin: 0;&quot;&gt;
            &lt;li&gt;&lt;strong&gt;DIAC:&lt;/strong&gt; Diode for Alternating Current - bidirectional trigger device&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Breakover Voltage:&lt;/strong&gt; Typically 28-36V for common DIACs (e.g., DB3)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Symmetric Operation:&lt;/strong&gt; Fires at same voltage in both polarities&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Frequency Control:&lt;/strong&gt; Adjust R1 or C1 to change oscillation frequency&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Applications:&lt;/strong&gt; TRIAC triggering, light dimmers, motor speed control, flash lamps&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Advantage:&lt;/strong&gt; Simple, reliable trigger generation without complex circuitry&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

&lt;/div&gt;"> 
