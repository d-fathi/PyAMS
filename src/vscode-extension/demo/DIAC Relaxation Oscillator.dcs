e-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: rgb(0, 0, 255); fill: none; stroke-width: 1px;"></polyline></g><polyline points="325,130 325,130 380,130 " class="polyline" name="net" xdir="true" ref="out2" parent="true" parentcolor="false" used="true" id="7" node0="1" node1="-1" diagonal="false" style="stroke: rgb(0, 0, 0); fill: none; stroke-width: 1px;" setref="out2"></polyline><polyline points="325,65 325,65 380,65 " class="polyline" name="net" xdir="true" ref="out1" parent="false" parentcolor="false" used="true" id="8" node0="0" node1="-1" style="stroke: rgb(0, 0, 0); fill: none; stroke-width: 1px;"></polyline><g transform="translate(435,22)" x="435" y="22" title="codeHTML" width="462" height="591" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="222" height="200" style="height: 591px; width: 770px;"><div name="htmlCode" style="zoom: 60%; height: 591px; width: 770px;" code="<div class=&quot;ch&quot;>
    
    <h1>DIAC Relaxation Oscillator - SPICE Time Domain Analysis</h1>

    <div class=&quot;ch-card&quot;>
        <h2>Circuit Components</h2>
        <ul>
            <li><strong>V1:</strong> DC Voltage Source = 60V</li>
            <li><strong>R1:</strong> 100 kΩ (charging resistor)</li>
            <li><strong>C1:</strong> 22 nF (timing capacitor)</li>
            <li><strong>X1:</strong> DIAC (bidirectional trigger diode)</li>
            <li><strong>R2:</strong> 10 Ω (discharge/load resistor)</li>
            <li><strong>Analysis Type:</strong> Time Domain (0s to 8ms)</li>
        </ul>
    </div>

    <h2>Time Constant &amp; Operating Principle</h2>
    <div class=&quot;ch-formula&quot;>
        τ = R1 × C1 = 100kΩ × 22nF = <strong>2.2 ms</strong><br>
        DIAC Breakover Voltage (VBO) ≈ <strong>30-35V</strong> (typical)<br>
        The capacitor charges through R1 until V(BO) is reached, then DIAC fires
    </div>

    <h2>Simulation Results</h2>
    <div class=&quot;ch-grid&quot;>

        <div class=&quot;ch-col blue&quot;>
            <h3>Capacitor Voltage V(out1) - Blue</h3>
            <ul>
                <li><strong>Sawtooth waveform</strong> with exponential charging curve</li>
                <li>Charges from ~16V up to ~35V (DIAC breakover voltage)</li>
                <li>Sharp discharge when DIAC triggers</li>
                <li>Period ≈ 1.5 ms (frequency ≈ 670 Hz)</li>
                <li>Peak voltage matches DIAC breakover threshold</li>
            </ul>
        </div>

        <div class=&quot;ch-col red&quot;>
            <h3>Output Pulses V(out2) - Red</h3>
            <ul>
                <li><strong>Short positive pulses</strong> at each DIAC firing</li>
                <li>Pulse amplitude: ~5V across R2</li>
                <li>Pulse width: very narrow (fast discharge through 10Ω)</li>
                <li>One pulse per oscillation cycle</li>
                <li>Represents the trigger output signal</li>
            </ul>
        </div>

    </div>

    <div class=&quot;ch-card green-border&quot;>
        <h2>Conclusion</h2>
        <p style=&quot;line-height: 1.6; margin: 0;&quot;>This circuit is a <strong>DIAC Relaxation Oscillator</strong> that generates periodic trigger pulses. The capacitor C1 charges exponentially through R1 from the 60V supply. When the capacitor voltage reaches the DIAC's breakover voltage (~30-35V), the DIAC switches from high impedance to low impedance state, causing rapid discharge of C1 through R2. This produces a sharp voltage pulse across R2 (V(out2)) and drops the capacitor voltage to a low value (~16V). The cycle then repeats as C1 begins charging again. The result is a <strong>sawtooth waveform</strong> at the capacitor and <strong>periodic trigger pulses</strong> at the output. This circuit is commonly used as a trigger generator for TRIACs in AC power control applications like dimmers and motor speed controllers.</p>
    </div>

    <div class=&quot;ch-card&quot; style=&quot;background-color: #e8f8f5; border-left: 4px solid #1abc9c;&quot;>
        <h2 style=&quot;color: #16a085;&quot;>DIAC Characteristics &amp; Applications</h2>
        <ul style=&quot;line-height: 1.6; margin: 0;&quot;>
            <li><strong>DIAC:</strong> Diode for Alternating Current - bidirectional trigger device</li>
            <li><strong>Breakover Voltage:</strong> Typically 28-36V for common DIACs (e.g., DB3)</li>
            <li><strong>Symmetric Operation:</strong> Fires at same voltage in both polarities</li>
            <li><strong>Frequency Control:</strong> Adjust R1 or C1 to change oscillation frequency</li>
            <li><strong>Applications:</strong> TRIAC triggering, light dimmers, motor speed control, flash lamps</li>
            <li><strong>Advantage:</strong> Simple, reliable trigger generation without complex circuitry</li>
        </ul>
    </div>

</div>"><div class="ch">
    
