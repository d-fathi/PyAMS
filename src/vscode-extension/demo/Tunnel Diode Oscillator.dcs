rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="37" y="17" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="35" y="22" transform="rotate(0 35 22)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none; fill: rgb(0, 0, 0);">n</text><text r="0" x="40" y="20" transform="rotate(0 40 20)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">-</text><ellipse cx="36.5" cy="20" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="35,18.5 35,21.5 33.5,20 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="26,10 31,10 31,30 26,30 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><text class="draggable" name="ref" x="18" y="5" r="0" transform="rotate(0 18 5)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">TD</text><polyline points="18,20 10,20 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="35,20 31,20 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polygon points="16,30 30,20 16,10 " class="draggable" name="polygon" style="stroke: rgb(33, 150, 243); fill: rgb(255, 255, 127); stroke-width: 1px; filter: drop-shadow(rgba(0, 0, 0, 0.5) 2px 2px 4px);"></polygon><text class="draggable" name="param" x="18" y="45" r="0" transform="rotate(0 18 45)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;" show="Name and value" paramname="Ip" paramvalue="5mA">Ip=5mA</text></g><g x="25" y="105" transform="translate(25,105)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X1" directory="std"><g w