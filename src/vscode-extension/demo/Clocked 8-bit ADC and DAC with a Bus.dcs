l: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="6" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><g x="65" y="215" transform="translate(65,215)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X3" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="7" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><text class="draggable" name="text" x="30" y="18" r="0" rtemp="0" transform="rotate(0 30 18)" style="fill: rgb(255, 123, 0); font-weight: normal; font-style: italic; font-size: 14px; font-family: lighter;">Clocked 8-bit ADC and DAC connected by a bus</text><text class="draggable" name="text" x="60" y="90" r="0" rtemp="0" transform="rotate(0 60 90)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">vin</text><text class="draggable" name="text" x="172" y="90" r="0" rtemp="0" transform="rotate(0 172 90)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">D[0:7] (bus, 8 lines)</text><text class="draggable" name="text" x="325" y="90" r="0" rtemp="0" transform="rotate(0 325 90)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">aout</text><text class="draggable" name="text" x="150" y="165" r="0" rtemp="0" transform="rotate(0 150 165)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">clk</text><g transform="translate(30,240)" x="30" y="240" width="420" height="230" class="analysis" name="analysis" description="{&quot;type&quot;:&quot;Time Domain&quot;,&quot;title&quot;:&quot;&quot;,&quot;dcsweep&quot;:{&quot;param&quot;:&quot;Non&quot;,&quot;unit&quot;:&quot;&quot;,&quot;start&quot;:&quot;0&quot;,&quot;stop&quot;:&quot;0&quot;,&quot;step&quot;:&quot;0&quot;,&quot;modified&quot;:false},&quot;time&quot;:{&quot;start&quot;:&quot;0s&quot;,&quot;stop&quot;:&quot;2ms&quot;,&quot;step&quot;:&quot;1us&quot;,&quot;modified&quot;:false},&quot;ac&quot;:{&quot;start&quot;:&quot;1&quot;,&quot;stop&quot;:&quot;1000&quot;,&quot;step&quot;:&quot;100&quot;,&quot;scale&quot;:&quot;dec&quot;,&quot;type&quot;:&quot;de&quot;,&quot;modified&quot;:false},&quot;yAxe&quot;:[{&quot;name&quot;:&quot;vin&quot;,&quot;color&quot;:&quot;#2a73c0&quot;},{&quot;name&quot;:&quot;aout&quot;,&quot;color&quot;:&quot;#d33636&quot;},{&quot;name&quot;:&quot;clk&quot;,&quot;color&quot;:&quot;#2f9e44&quot;,&quot;digital&quot;:{&quot;nodes&quot;:[&quot;clk&quot;],&quot;fmt&quot;:&quot;bit&quot;}},{&quot;name&quot;:&quot;D[0:7]&quot;,&quot;color&quot;:&quot;#8a63d2&quot;,&quot;digital&quot;:{&quot;nodes&quot;:[&quot;D0&quot;,&quot;D1&quot;,&quot;D2&quot;,&quot;D3&quot;,&quot;D4&quot;,&quot;D5&quot;,&quot;D6&quot;,&quot;D7&quot;],&quot;fmt&quot;:&quot;hex&quot;}}],&quot;xAxe&quot;:{&quot;name&quot;:&quot;None&quot;,&quot;unit&quot;:&quot;&quot;,&quot;type&quot;:&quot;&quot;,&quot;color&quot;:&quot;#000000&quot;,&quot;used&quot;:false},&quot;layout&quot;:{&quot;margin&quot;:{&quot;l&quot;:35,&quot;r&quot;:25,&quot;b&quot;:80,&quot;t&quot;:35},&quot;font&quot;:{&quot;color&quot;:&quot;#333333&quot;,&quot;size&quot;:11,&quot;family&quot;:&quot;Arial&quot;},&quot;paper_bgcolor&quot;:&quot;#ffffff&quot;,&quot;plot_bgcolor&quot;:&quot;#f8f8f8&quot;,&quot;bordercolor&quot;:&quot;#cccccc&quot;,&quot;yaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;xaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;showlegend&quot;:true,&quot;grid&quot;:{&quot;rows&quot;:1,&quot;columns&quot;:1,&quot;pattern&quot;:&quot;independent&quot;,&quot;roworder&quot;:&quot;bottom to top&quot;}},&quot;options&quot;:{&quot;adaptive&quot;:true,&quot;max_step&quot;:0.000002},&quot;sweep&quot;:{&quot;param&quot;:&quot;&quot;,&quot;values&quot;:&quot;[]&quot;},&quot;wavevth&quot;:&quot;&quot;}"><foreignObject x="0" y="0" width="420" height="230"><div name="plots" style="border-style: double; transform-origin: 0px 0px; transform: scale(0.6); box-sizing: border-box; border-width: 3px; margin: 0px; padding: 0px; width: 700px; height: 383.333px;" ondblclick="showPlotInModel(this)"></div></foreignObject></g><g transform="translate(470,20)" x="470" y="20" title="codeHTML" width="560" height="518" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="560" height="518" style="width: 560px; height: 518px;"><div name="htmlCode" style="zoom: 0.56; height: 925px; width: 1000px;" code="&lt;div class=&quot;ch&quot;&gt;
&lt;h1&gt;Clocked 8-bit ADC and DAC joined by a Bus&lt;/h1&gt;

&lt;div class=&quot;ch-card&quot;&gt;
&lt;h2&gt;Circuit Components&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Source (V1):&lt;/strong&gt; &lt;em&gt;SinVoltage&lt;/em&gt;, 2.5 V &amp;plusmn; 2.4 V at 1 kHz&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Clock (Vk):&lt;/strong&gt; &lt;em&gt;TrapezoidVoltage&lt;/em&gt;, 0 / 5 V, period 62.5 &amp;micro;s (16 kHz), rise and fall time 100 ns&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;ADC (U1):&lt;/strong&gt; &lt;em&gt;ADC_clocked&lt;/em&gt;, 8 bits, V&lt;sub&gt;ref&lt;/sub&gt; = 5 V. Samples &lt;em&gt;vin&lt;/em&gt; on each rising edge of &lt;em&gt;clk&lt;/em&gt;; the code goes on the bus pin &lt;em&gt;D[0:7]&lt;/em&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;DAC (U2):&lt;/strong&gt; &lt;em&gt;DAC_clocked&lt;/em&gt;, 8 bits, V&lt;sub&gt;ref&lt;/sub&gt; = 5 V. Its input register captures the bus on each rising edge of the same clock and holds the output &lt;em&gt;aout&lt;/em&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Load (R1):&lt;/strong&gt; 10 k&amp;Omega; to ground&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;

&lt;h2&gt;The bus and the clock&lt;/h2&gt;
&lt;p&gt;The bus is the wire named &lt;strong&gt;D[0:7]&lt;/strong&gt;, joining two bus pins of the same width. In the generated code each bus pin is the list of its 8 nodes:&lt;/p&gt;
&lt;div class=&quot;ch-formula&quot;&gt;
U1 = ADC_clocked(&quot;vin&quot;, &quot;clk&quot;, [&quot;D0&quot;, &quot;D1&quot;, &quot;D2&quot;, &quot;D3&quot;, &quot;D4&quot;, &quot;D5&quot;, &quot;D6&quot;, &quot;D7&quot;])&lt;br&gt;
U2 = DAC_clocked([&quot;D0&quot;, &quot;D1&quot;, &quot;D2&quot;, &quot;D3&quot;, &quot;D4&quot;, &quot;D5&quot;, &quot;D6&quot;, &quot;D7&quot;], &quot;clk&quot;, &quot;aout&quot;)
&lt;/div&gt;
&lt;p&gt;Both converters use the same clock. At an edge the ADC samples the input and its outputs change a few nanoseconds later; the DAC reads the bus at the instant of the same edge, i.e. the &lt;em&gt;previous&lt;/em&gt; code. The pair therefore behaves like a pipeline with a delay of &lt;strong&gt;one clock period&lt;/strong&gt;.&lt;/p&gt;

&lt;h2&gt;Principle&lt;/h2&gt;
&lt;div class=&quot;ch-formula&quot;&gt;
$\text{code}_k = \left\lfloor \dfrac{V_{in}(t_k)}{V_{ref}}\, 2^N \right\rfloor \qquad V_{out}(t) = V_{ref}\,\dfrac{\text{code}_{k-1}}{2^N}\quad t_k &lt; t &lt; t_{k+1}$
&lt;/div&gt;
&lt;p&gt;The sampling instant t&lt;sub&gt;k&lt;/sub&gt; is the moment the clock crosses its threshold (2.5 V), found by interpolation between two accepted time points, so it does not depend on the time step. The clock needs a finite rise time, and the analysis uses &lt;em&gt;max_step&lt;/em&gt; = 2 &amp;micro;s to follow it.&lt;/p&gt;

&lt;div class=&quot;ch-grid&quot;&gt;
&lt;div class=&quot;ch-col blue&quot;&gt;
&lt;h3&gt;Results (0 &amp;hellip; 2 ms)&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;em&gt;aout&lt;/em&gt; is a staircase: it is exactly constant between two edges and stays at 0 V until the second edge&lt;/li&gt;
&lt;li&gt;After each edge &lt;em&gt;aout&lt;/em&gt; equals the code sampled one period earlier: the 29 edges checked agree within 0.5 mV (1 LSB = 19.5 mV)&lt;/li&gt;
&lt;li&gt;16 samples per sine period: the staircase is coarse in time, fine in amplitude&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class=&quot;ch-col green&quot;&gt;
&lt;h3&gt;Things to try&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Double the clock frequency (T = 31.25 &amp;micro;s, Tw = 15.6 &amp;micro;s): the steps become finer&lt;/li&gt;
&lt;li&gt;Use different clocks for U1 and U2 to see the sample-and-hold effect&lt;/li&gt;
&lt;li&gt;Plot &lt;em&gt;D7&lt;/em&gt; or &lt;em&gt;D0&lt;/em&gt;: they change only just after a clock edge&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
"> 
    <!-- Parent container that responds to mouse movement -->
    <div class="chtool"> 
        
        <!-- tool bar-->
        <div class="ch-page-toolbar" style="zoom: 1.78571;">
            <button class="ch-toolbar-button" title="Home">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3 L3 10 V21 H9 V15 H15 V21 H21 V10 Z"></path>
                </svg>
            </button>
            <button class="ch-toolbar-button" title="Modified" onclick="modifyAction()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
