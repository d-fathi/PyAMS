 rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="12.5,20 15.5,20 14,21.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><g points="14,60 14,50 " class="polyline" name="pin" type="simple" netid="7" netidpos="0"><polyline points="14,60 14,50 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="11" y="57" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="12" y="48" transform="rotate(0 12 48)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">n</text><text r="0" x="14" y="60" transform="rotate(0 14 60)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">-</text><ellipse cx="14" cy="53.5" rx="3.5" ry="3.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="10.5,50 17.5,50 14,46.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><text class="var" name="ref" x="32" y="32" r="0" transform="rotate(0 32 32)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">Vk</text><ellipse class="draggable" name="ellipse" cx="14" cy="35" rx="15" ry="15" style="stroke: rgb(33, 150, 243); fill: rgb(255, 255, 127); stroke-width: 1px; filter: drop-shadow(rgba(0, 0, 0, 0.5) 2px 2px 4px);"></ellipse><polyline points="16,24 12,24 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="14,26 14,22 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="5,40 9,40 12,29 17,29 19,40 24,40 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><text class="var" name="param" x="33" y="42" r="0" rtemp="0" paramname="V0" paramvalue="0V" show="Name and value" transform="rotate(0 33 42)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">V0=0V</text><polyline points="14,20 14,16 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); stroke-width: 1px; fill: none;"></polyline><polyline points="14,50 14,54 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); stroke-width: 1px; fill: none;"></polyline><text class="var" name="param" x="33" y="52" r="0" rtemp="0" paramname="V1" paramvalue="5V" show="Name and value" transform="rotate(0 33 52)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">V1=5V</text><text class="var" name="param" x="33" y="63" r="0" rtemp="0" paramname="Tw" paramvalue="31.25us" show="Name and value" transform="rotate(0 33 63)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">Tw=31.25us</text><text class="var" name="param" x="34" y="74" r="0" rtemp="0" paramname="T" paramvalue="62.5us" show="Name and value" transform="rotate(0 34 74)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">T=62.5us</text><text class="var" name="param" x="34" y="95" r="0" rtemp="0" paramname="Tr" paramvalue="100ns" show="Name and value" transform="rotate(0 34 95)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">Tr=100ns</text><text class="var" name="param" x="34" y="106" r="0" rtemp="0" paramname="Tf" paramvalue="100ns" show="Name and value" transform="rotate(0 34 106)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">Tf=100ns</text></g><g x="15" y="145" transform="translate(15,145)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X1" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;re