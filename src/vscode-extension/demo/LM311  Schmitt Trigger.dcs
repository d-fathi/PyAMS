="1em" width="1em"><path d="m0 788l0-876 875 0 0 876-875 0z m688-500l-500 0 0 125 500 0 0-125z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a><a rel="tooltip" class="modebar-btn" data-title="Autoscale" data-attr="zoom" data-val="auto" data-toggle="false" data-gravity="n"><svg viewBox="0 0 1000 1000" class="icon" height="1em" width="1em"><path d="m250 850l-187 0-63 0 0-62 0-188 63 0 0 188 187 0 0 62z m688 0l-188 0 0-62 188 0 0-188 62 0 0 188 0 62-62 0z m-875-938l0 188-63 0 0-188 0-62 63 0 187 0 0 62-187 0z m875 188l0-188-188 0 0-62 188 0 62 0 0 62 0 188-62 0z m-125 188l-1 0-93-94-156 156 156 156 92-93 2 0 0 250-250 0 0-2 93-92-156-156-156 156 94 92 0 2-250 0 0-250 0 0 93 93 157-156-157-156-93 94 0 0 0-250 250 0 0 0-94 93 156 157 156-157-93-93 0 0 250 0 0 250z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a></div><div class="modebar-group"><a rel="tooltip" class="modebar-btn" data-title="Show closest data on hover" data-attr="hovermode" data-val="closest" data-toggle="false" data-gravity="ne"><svg viewBox="0 0 1500 1000" class="icon" height="1em" width="1em"><path d="m375 725l0 0-375-375 375-374 0-1 1125 0 0 750-1125 0z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a><a rel="tooltip" class="modebar-btn active" data-title="Compare data on hover" data-attr="hovermode" data-val="x" data-toggle="false" data-gravity="ne"><svg viewBox="0 0 1125 1000" class="icon" height="1em" width="1em"><path d="m187 786l0 2-187-188 188-187 0 0 937 0 0 373-938 0z m0-499l0 1-187-188 188-188 0 0 937 0 0 376-938-1z" transform="matrix(1 0 0 -1 0 850)"></path></svg></a></div></div></div><svg class="main-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="515" height="288.33333333333337"><g class="hoverlayer"></g></svg></div></div></div></foreignObject></g><g transform="translate(352,23)" x="352" y="23" title="codeHTML" width="418" height="498" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="222" height="200" style="height: 498px; width: 696.667px;"><div name="htmlCode" style="zoom: 60%; height: 498px; width: 696.667px;" code="<div class=&quot;ch&quot;>
    
    <h1>Non-Inverting Schmitt Trigger (LM311 Comparator) - SPICE Time Domain Analysis</h1>

    <div class=&quot;ch-card&quot;>
        <h2>Circuit Components</h2>
        <ul>
            <li><strong>Comparator:</strong> LM311 (open-collector output)</li>
            <li><strong>V1:</strong> DC Supply = 5V</li>
            <li><strong>V2:</strong> Sinusoidal Source SIN(2.5 1 1k) - 1V amplitude, 2.5V offset, 1 kHz</li>
            <li><strong>R1, R3:</strong> 10 kΩ each (voltage divider for reference)</li>
            <li><strong>R2:</strong> 470 kΩ (positive feedback - hysteresis)</li>
            <li><strong>R4:</strong> 1 kΩ (pull-up resistor for open-collector output)</li>
        </ul>
    </div>

    <h2>Reference Voltage &amp; Thresholds</h2>
    <div class=&quot;ch-formula&quot;>
        Vref = V1 × R3/(R1+R3) = 5V × 10k/20k = <strong>2.5V</strong><br>
        Feedback factor β = R3/(R2+R3) ≈ 10k/480k ≈ 0.021<br>
        Vth+ ≈ Vref + β·Vout_high ≈ 2.5V + 0.1V = <strong>2.6V</strong><br>
        Vth- ≈ Vref - β·Vout_high ≈ 2.5V - 0.1V = <strong>2.4V</strong><br>
        Hysteresis width ≈ <strong>0.2V</strong> (narrow due to large R2)
    </div>

    <h2>Simulation Results</h2>
    <div class=&quot;ch-grid&quot;>

        <div class=&quot;ch-col blue&quot;>
            <h3>Input Signal V(in) - Blue</h3>
            <ul>
                <li>Sinusoidal waveform centered at 2.5V</li>
                <li>Amplitude: 1V (swings between 1.5V and 3.5V)</li>
                <li>Frequency: 1 kHz (period = 1 ms)</li>
                <li>Crosses both threshold voltages twice per cycle</li>
                <li>AC signal with DC offset</li>
            </ul>
        </div>

        <div class=&quot;ch-col red&quot;>
            <h3>Output Signal V(out) - Red</h3>
            <ul>
                <li>Square wave oscillating between 0V and ~5V</li>
                <li>Output HIGH (~5V) when V(in) > Vth+</li>
                <li>Output LOW (0V) when V(in) < Vth-</li>
                <li>Frequency: 1 kHz (same as input)</li>
                <li>Non-inverting behavior (output follows input polarity)</li>
            </ul>
        </div>

    </div>

    <div class=&quot;ch-card green-border&quot;>
        <h2>Conclusion</h2>
        <p style=&quot;line-height: 1.6; margin: 0;&quot;>This circuit is a <strong>Non-Inverting Schmitt Trigger</strong> using an LM311 comparator with positive feedback. The voltage divider (R1, R3) sets a reference voltage of 2.5V at the non-inverting input. The large feedback resistor R2 (470 kΩ) creates a small hysteresis window (~0.2V) around the reference voltage, providing noise immunity while maintaining sensitive switching. When the input sine wave exceeds the upper threshold (~2.6V), the output switches HIGH to ~5V. When it falls below the lower threshold (~2.4V), the output switches LOW to 0V. The LM311's open-collector output requires the pull-up resistor R4 to achieve the HIGH state. The result is a clean square wave output synchronized with the 1 kHz input signal.</p>
    </div>

    <div class=&quot;ch-card&quot; style=&quot;background-color: #e8f8f5; border-left: 4px solid #1abc9c;&quot;>
        <h2 style=&quot;color: #16a085;&quot;>LM311 Comparator Features</h2>
        <ul style=&quot;line-height: 1.6; margin: 0;&quot;>
            <li><strong>Open-Collector Output:</strong> Requires external pull-up resistor (R4)</li>
            <li><strong>Fast Response:</strong> Typical propagation delay ~200ns</li>
            <li><strong>Wide Supply Range:</strong> Single or dual supply operation</li>
            <li><strong>Hysteresis Benefit:</strong> Prevents multiple transitions from noisy signals</li>
            <li><strong>Applications:</strong> Zero-crossing detectors, level detectors, waveform conversion, PWM generation</li>
        </ul>
    </div>

</div>"><div class="ch">
    
    <h1>Non-Inverting Schmitt Trigger (LM311 Comparator) - SPICE Time Domain Analysis</h1>

    <div class="ch-card">
        <h2>Circuit Components</h2>
        <ul>
            <li><strong>Comparator:</strong> LM311 (open-collector output)</li>
            <li><strong>V1:</strong> DC Supply = 5V</li>
            <li><strong>V2:</strong> Sinusoidal Source SIN(2.5 1 1k) - 1V amplitude, 2.5V offset, 1 kHz</li>
            <li><strong>R1, R3:</strong> 10 kΩ each (voltage divider for reference)</li>
            <li><strong>R2:</strong> 470 kΩ (positive feedback - hysteresis)</li>
            <li><strong>R4:</strong> 1 kΩ (pull-up resistor for open-collector output)</li>
        </ul>
    </div>

    <h2>Reference Voltage &amp; Thresholds</h2>
    <div class="ch-formula">
        Vref = V1 × R3/(R1+R3) = 5V × 10k/20k = <strong>2.5V</strong><br>
        Feedback factor β = R3/(R2+R3) ≈ 10k/480k ≈ 0.021<br>
        Vth+ ≈ Vref + β·Vout_high ≈ 2.5V + 0.1V = <strong>2.6V</strong><br>
        Vth- ≈ Vref - β·Vout_high ≈ 2.5V - 0.1V = <strong>2.4V</strong><br>
        Hysteresis width ≈ <strong>0.2V</strong> (narrow due to large R2)
    </div>

    <h2>Simulation Results</h2>
    <div class="ch-grid">

        <div class="ch-col blue">
            <h3>Input Signal V(in) - Blue</h3>
            <ul>
                <li>Sinusoidal waveform centered at 2.5V</li>
                <li>Amplitude: 1V (swings between 1.5V and 3.5V)</li>
                <li>Frequency: 1 kHz (period = 1 ms)</li>
                <li>Crosses both threshold voltages twice per cycle</li>
                <li>AC signal with DC offset</li>
            </ul>
        </div>

        <div class="ch-col red">
            <h3>Output Signal V(out) - Red</h3>
            <ul>
                <li>Square wave oscillating between 0V and ~5V</li>
                <li>Output HIGH (~5V) when V(in) &gt; Vth+</li>
                <li>Output LOW (0V) when V(in) &lt; Vth-</li>
                <li>Frequency: 1 kHz (same as input)</li>
                <li>Non-inverting behavior (output follows input polarity)</li>
            </ul>
        </div>

    </div>

    <div class="ch-card green-border">
        <h2>Conclusion</h2>
        <p style="line-height: 1.6; margin: 0;">This circuit is a <strong>Non-Inverting Schmitt Trigger</strong> using an LM311 comparator with positive feedback. The voltage divider (R1, R3) sets a reference voltage of 2.5V at the non-inverting input. The large feedback resistor R2 (470 kΩ) creates a small hysteresis window (~0.2V) around the reference voltage, providing noise immunity while maintaining sensitive switching. When the input sine wave exceeds the upper threshold (~2.6V), the output switches HIGH to ~5V. When it falls below the lower threshold (~2.4V), the output switches LOW to 0V. The LM311's open-collector output requires the pull-up resistor R4 to achieve the HIGH state. The result is a clean square wave output synchronized with the 1 kHz input signal.</p>
    </div>

    <div class="ch-card" style="background-color: #e8f8f5; border-left: 4px solid #1abc9c;">
        <h2 style="color: #16a085;">LM311 Comparator Features</h2>
        <ul style="line-height: 1.6; margin: 0;">
            <li><strong>Open-Collector Output:</strong> Requires external pull-up resistor (R4)</li>
            <li><strong>Fast Response:</strong> Typical propagation delay ~200ns</li>
            <li><strong>Wide Supply Range:</strong> Single or dual supply operation</li>
            <li><strong>Hysteresis Benefit:</strong> Prevents multiple transitions from noisy signals</li>
            <li><strong>Applications:</strong> Zero-crossing detectors, level detectors, waveform conversion, PWM generation</li>
        </ul>
    </div>

</div></div></foreignObject></g>