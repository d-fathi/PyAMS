, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><g x="75" y="140" transform="translate(75,140)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X3" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="5" netidpos="0" netId="5" netIdPos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><polyline points="90,145 90,134 90,134 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="5" node0="-1" node1="1" style="stroke: rgb(99, 8, 17); stroke-width: 1.3px; fill: none;"></polyline><polyline points="200,145 200,134 200,134 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="6" node0="-1" node1="4" style="stroke: rgb(99, 8, 17); stroke-width: 1.3px; fill: none;"></polyline><text class="draggable" name="text" x="50" y="25" r="0" rtemp="0" transform="rotate(0 50  25)" style="fill: rgb(244, 115, 93); font-weight: normal; font-style: normal; font-size: 10px; font-family: normal;">in</text><text class="draggable" name="text" x="209" y="25" r="0" rtemp="0" transform="rotate(0 209  25)" style="fill: rgb(0, 255, 64); font-weight: normal; font-style: normal; font-size: 10px; font-family: normal;">out</text><text class="draggable" name="text" x="159" y="63" r="0" rtemp="0" transform="rotate(0 159  63)" style="fill: rgb(255, 123, 0); font-weight: normal; font-style: normal; font-size: 10px; font-family: normal;">CCCS</text><g transform="translate(379,37)" x="379" y="37" title="codeHTML" width="427" height="546" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="222" height="200" style="height: 546px; width: 711.667px;"><div name="htmlCode" style="zoom: 60%; height: 546px; width: 711.667px;" code="&lt;div class=&quot;ch&quot;&gt;
    
    &lt;h1&gt;CCCS Current Mirror Amplifier - PyAMS Time Domain Analysis&lt;/h1&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Circuit Components&lt;/h2&gt;
        &lt;h3 style=&quot;color: #2980b9;&quot;&gt;Input Stage&lt;/h3&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;V1:&lt;/strong&gt; AC Voltage Source, Va=10V, Fr=100Hz&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;R1:&lt;/strong&gt; 100 Ω (input resistor)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Diode:&lt;/strong&gt; Control element for CCCS&lt;/li&gt;
        &lt;/ul&gt;
        &lt;h3 style=&quot;color: #c0392b; margin-top: 15px;&quot;&gt;Output Stage&lt;/h3&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;X1:&lt;/strong&gt; CCCS (Current-Controlled Current Source), Gain=1&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;R2:&lt;/strong&gt; 100 Ω (output/load resistor)&lt;/li&gt;
        &lt;/ul&gt;
        &lt;h3 style=&quot;color: #27ae60; margin-top: 15px;&quot;&gt;Analysis Parameters&lt;/h3&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;Type:&lt;/strong&gt; Time Domain&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Duration:&lt;/strong&gt; 0s to 0.02s (2 complete cycles at 100Hz)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Step:&lt;/strong&gt; 50 μs&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;UIC:&lt;/strong&gt; true (Use Initial Conditions)&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

    &lt;h2&gt;Circuit Operation Principle&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        Input current: I_in = V(in) / R1&lt;br&gt;
        CCCS output current: I_out = Gain × I_in = 1 × I_in = I_in&lt;br&gt;
        Output voltage: V(out) = -I_out × R2 = -I_in × R2&lt;br&gt;
        Since R1 = R2 = 100Ω: V(out) = -V(in)&lt;br&gt;
        &lt;strong&gt;Voltage Gain = -1 (Unity gain inverter)&lt;/strong&gt;
    &lt;/div&gt;

    &lt;h2&gt;Simulation Results&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;

        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Input Voltage V(in) - Red&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;Sinusoidal waveform at 100 Hz&lt;/li&gt;
                &lt;li&gt;Amplitude: ±10V (peak-to-peak = 20V)&lt;/li&gt;
                &lt;li&gt;Period: 10 ms (0.01s)&lt;/li&gt;
                &lt;li&gt;2 complete cycles in 20ms simulation&lt;/li&gt;
                &lt;li&gt;Drives the input current through R1&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;Output Voltage V(out) - Green&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;Sinusoidal waveform at 100 Hz&lt;/li&gt;
                &lt;li&gt;Amplitude: ±10V (same as input)&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;180° phase shift&lt;/strong&gt; (inverted relative to input)&lt;/li&gt;
                &lt;li&gt;Unity voltage gain (|Av| = 1)&lt;/li&gt;
                &lt;li&gt;Perfect current mirroring with inversion&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

    &lt;/div&gt;

    &lt;div class=&quot;ch-card green-border&quot;&gt;
        &lt;h2&gt;Conclusion&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;This circuit demonstrates a &lt;strong&gt;CCCS-based current mirror amplifier&lt;/strong&gt; with unity gain. The input AC source drives a current through R1 and the diode, which controls the CCCS. The CCCS replicates this current with a gain of 1 and delivers it to the output resistor R2. Since R1 = R2 = 100Ω, the output voltage magnitude equals the input voltage magnitude, but with &lt;strong&gt;180° phase inversion&lt;/strong&gt; due to the current direction convention. The circuit acts as a perfect inverting buffer, maintaining signal integrity while providing isolation between input and output stages. The simulation shows clean sinusoidal waveforms with no distortion, confirming ideal CCCS behavior.&lt;/p&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card&quot; style=&quot;background-color: #e8f8f5; border-left: 4px solid #1abc9c;&quot;&gt;
        &lt;h2 style=&quot;color: #16a085;&quot;&gt;CCCS Characteristics &amp; Applications&lt;/h2&gt;
        &lt;ul style=&quot;line-height: 1.6; margin: 0;&quot;&gt;
            &lt;li&gt;&lt;strong&gt;CCCS:&lt;/strong&gt; Current-Controlled Current Source - output current proportional to input current&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Gain = 1:&lt;/strong&gt; Unity current gain (current mirror configuration)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Isolation:&lt;/strong&gt; Input and output circuits are electrically isolated&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Inversion:&lt;/strong&gt; Output is 180° out of phase with input&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Applications:&lt;/strong&gt; Current mirrors, signal isolation, current amplification, analog computing, transistor modeling&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Advantage:&lt;/strong&gt; Provides current buffering without loading the input source&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

&lt;/div&gt;"> 
    <!-- Parent container that responds to mouse movement -->
    <div class="chtool"> 
        
        <!-- tool bar-->
        <div class="ch-page-toolbar">
            <button class="ch-toolbar-button" title="Home" onclick="goHome()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3 L3 10 V21 H9 V15 H15 V21 H21 V10 Z"></path>
                </svg>
            </button>
            <button class="ch-toolbar-button" title="Modified" onclick="modifyAction()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"></path>
                </svg>
            </button>
        </div>

       <div class="ch">
    
    <h1>CCCS Current Mirror Amplifier - PyAMS Time Domain Analysis</h1>

    <div class="ch-card">
        <h2>Circuit Components</h2>
        <h3 style="color: #2980b9;">Input Stage</h3>
        <ul>
            <li><strong>V1:</strong> AC Voltage Source, Va=10V, Fr=100Hz</li>
            <li><strong>R1:</strong> 100 Ω (input resistor)</li>
            <li><strong>Diode:</strong> Control element for CCCS</li>
        </ul>
        <h3 style="color: #c0392b; margin-top: 15px;">Output Stage</h3>
        <ul>
            <li><strong>X1:</strong> CCCS (Current-Controlled Current Source), Gain=1</li>
            <li><strong>R2:</strong> 100 Ω (output/load resistor)</li>
        </ul>
        <h3 style="color: #27ae60; margin-top: 15px;">Analysis Parameters</h3>
        <ul>
            <li><strong>Type:</strong> Time Domain</li>
            <li><strong>Duration:</strong> 0s to 0.02s (2 complete cycles at 100Hz)</li>
            <li><strong>Step:</strong> 50 μs</li>
            <li><strong>UIC:</strong> true (Use Initial Conditions)</li>
        </ul>
    </div>

    <h2>Circuit Operation Principle</h2>
    <div class="ch-formula">
        Input current: I_in = V(in) / R1<br>
        CCCS output current: I_out = Gain × I_in = 1 × I_in = I_in<br>
        Output voltage: V(out) = -I_out × R2 = -I_in × R2<br>
        Since R1 = R2 = 100Ω: V(out) = -V(in)<br>
        <strong>Voltage Gain = -1 (Unity gain inverter)</strong>
    </div>

    <h2>Simulation Results</h2>
    <div class="ch-grid">

        <div class="ch-col blue">
            <h3>Input Voltage V(in) - Red</h3>
            <ul>
                <li>Sinusoidal waveform at 100 Hz</li>
                <li>Amplitude: ±10V (peak-to-peak = 20V)</li>
                <li>Period: 10 ms (0.01s)</li>
                <li>2 complete cycles in 20ms simulation</li>
                <li>Drives the input current through R1</li>
            </ul>
        </div>

        <div class="ch-col red">
            <h3>Output Voltage V(out) - Green</h3>
            <ul>
                <li>Sinusoidal waveform at 100 Hz</li>
                <li>Amplitude: ±10V (same as input)</li>
                <li><strong>180° phase shift</strong> (inverted relative to input)</li>
                <li>Unity voltage gain (|Av| = 1)</li>
                <li>Perfect current mirroring with inversion</li>
            </ul>
        </div>

    </div>

    <div class="ch-card green-border">
        <h2>Conclusion</h2>
        <p style="line-height: 1.6; margin: 0;">This circuit demonstrates a <strong>CCCS-based current mirror amplifier</strong> with unity gain. The input AC source drives a current through R1 and the diode, which controls the CCCS. The CCCS replicates this current with a gain of 1 and delivers it to the output resistor R2. Since R1 = R2 = 100Ω, the output voltage magnitude equals the input voltage magnitude, but with <strong>180° phase inversion</strong> due to the current direction convention. The circuit acts as a perfect inverting buffer, maintaining signal integrity while providing isolation between input and output stages. The simulation shows clean sinusoidal waveforms with no distortion, confirming ideal CCCS behavior.</p>
    </div>

    <div class="ch-card" style="background-color: #e8f8f5; border-left: 4px solid #1abc9c;">
        <h2 style="color: #16a085;">CCCS Characteristics &amp; Applications</h2>
        <ul style="line-height: 1.6; margin: 0;">
            <li><strong>CCCS:</strong> Current-Controlled Current Source - output current proportional to input current</li>
            <li><strong>Gain = 1:</strong> Unity current gain (current mirror configuration)</li>
            <li><strong>Isolation:</strong> Input and output circuits are electrically isolated</li>
            <li><strong>Inversion:</strong> Output is 180° out of phase with input</li>
            <li><strong>Applications:</strong> Current mirrors, signal isolation, current amplification, analog computing, transistor modeling</li>
            <li><strong>Advantage:</strong> Provides current buffering without loading the input source</li>
        </ul>
    </div>

</div>
    </div>
