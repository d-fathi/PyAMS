;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="3" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><text class="draggable" name="text" x="30" y="18" r="0" rtemp="0" transform="rotate(0 30 18)" style="fill: rgb(255, 123, 0); font-weight: normal; font-style: italic; font-size: 14px; font-family: lighter;">Zener diode I-V characteristic (DC sweep)</text><text class="draggable" name="text" x="118" y="120" r="0" rtemp="0" transform="rotate(0 118 120)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">out</text><g transform="translate(30,280)" x="30" y="280" width="420" height="230" class="analysis" name="analysis" description="{&quot;type&quot;:&quot;DC Sweep&quot;,&quot;title&quot;:&quot;&quot;,&quot;dcsweep&quot;:{&quot;param&quot;:&quot;V1.Vdc&quot;,&quot;unit&quot;:&quot;V&quot;,&quot;start&quot;:&quot;-10&quot;,&quot;stop&quot;:&quot;2&quot;,&quot;step&quot;:&quot;0.05&quot;,&quot;modified&quot;:false},&quot;time&quot;:{&quot;start&quot;:&quot;0s&quot;,&quot;stop&quot;:&quot;0s&quot;,&quot;step&quot;:&quot;0s&quot;,&quot;modified&quot;:false},&quot;ac&quot;:{&quot;start&quot;:&quot;1&quot;,&quot;stop&quot;:&quot;1000&quot;,&quot;step&quot;:&quot;100&quot;,&quot;scale&quot;:&quot;dec&quot;,&quot;type&quot;:&quot;de&quot;,&quot;modified&quot;:false},&quot;yAxe&quot;:[{&quot;name&quot;:&quot;Z1.I&quot;,&quot;color&quot;:&quot;#d33636&quot;}],&quot;xAxe&quot;:{&quot;name&quot;:&quot;out&quot;,&quot;unit&quot;:&quot;V&quot;,&quot;type&quot;:&quot;&quot;,&quot;color&quot;:&quot;#000000&quot;,&quot;used&quot;:true},&quot;layout&quot;:{&quot;margin&quot;:{&quot;l&quot;:35,&quot;r&quot;:25,&quot;b&quot;:80,&quot;t&quot;:35},&quot;font&quot;:{&quot;color&quot;:&quot;#333333&quot;,&quot;size&quot;:11,&quot;family&quot;:&quot;Arial&quot;},&quot;paper_bgcolor&quot;:&quot;#ffffff&quot;,&quot;plot_bgcolor&quot;:&quot;#f8f8f8&quot;,&quot;bordercolor&quot;:&quot;#cccccc&quot;,&quot;yaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;xaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;showlegend&quot;:true,&quot;grid&quot;:{&quot;rows&quot;:1,&quot;columns&quot;:1,&quot;pattern&quot;:&quot;independent&quot;,&quot;roworder&quot;:&quot;bottom to top&quot;}},&quot;options&quot;:{},&quot;sweep&quot;:{&quot;param&quot;:&quot;&quot;,&quot;values&quot;:&quot;[]&quot;}}"><foreignObject x="0" y="0" width="420" height="230"><div name="plots" style="border-style: double; transform-origin: 0px 0px; transform: scale(0.6); box-sizing: border-box; border-width: 3px; margin: 0px; padding: 0px; width: 700px; height: 383.333px;" ondblclick="showPlotInModel(this)"></div></foreignObject></g><g transform="translate(470,20)" x="470" y="20" title="codeHTML" width="560" height="746" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="560" height="746" style="width: 560px; height: 746px;"><div name="htmlCode" style="zoom: 0.56; height: 1332.14px; width: 1000px;" code="&lt;div class=&quot;ch&quot;&gt;
&lt;h1&gt;Zener Diode I-V Characteristic (DC Sweep)&lt;/h1&gt;

&lt;div class=&quot;ch-card&quot;&gt;
&lt;h2&gt;Circuit Components&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Source (V1):&lt;/strong&gt; DC voltage swept from &amp;minus;10 V to +2 V (step 0.05 V) by the DC Sweep analysis, parameter &lt;em&gt;V1.Vdc&lt;/em&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Resistor (R1):&lt;/strong&gt; 100 &amp;Omega;, limits the current of the diode. Without it a sweep source would force an unlimited current through the diode&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Zener diode (Z1):&lt;/strong&gt; &lt;em&gt;ZenerDiode&lt;/em&gt; with V&lt;sub&gt;z&lt;/sub&gt; = 5.1 V at the test current I&lt;sub&gt;bv&lt;/sub&gt; = 1 mA, N&lt;sub&gt;z&lt;/sub&gt; = 1.5, R&lt;sub&gt;z&lt;/sub&gt; = 5 &amp;Omega;&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;

&lt;h2&gt;How the Characteristic Is Obtained&lt;/h2&gt;
&lt;p&gt;The anode of Z1 is connected to the node &lt;em&gt;out&lt;/em&gt; and the cathode to ground, so the voltage of &lt;em&gt;out&lt;/em&gt; is exactly the voltage across the diode, V = V&lt;sub&gt;AK&lt;/sub&gt;. The plot uses &lt;strong&gt;out&lt;/strong&gt; as the X axis and the diode current &lt;strong&gt;Z1.I&lt;/strong&gt; as the Y axis: forward conduction is on the right and the breakdown on the left.&lt;/p&gt;
&lt;div class=&quot;ch-formula&quot;&gt;
$V_{out} = V_1 - R_1\, I$ &amp;nbsp;&amp;nbsp; (the load line of R1 moves along the characteristic as V1 changes)
&lt;/div&gt;

&lt;h2&gt;The Three Regions&lt;/h2&gt;
&lt;div class=&quot;ch-grid&quot;&gt;
&lt;div class=&quot;ch-col blue&quot;&gt;
&lt;h3&gt;Forward (V &amp;gt; 0)&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;$I = I_s\left(e^{V/(N V_t)} - 1\right)$&lt;/li&gt;
&lt;li&gt;The diode starts to conduct near 0.6 V&lt;/li&gt;
&lt;li&gt;At V1 = 2 V: V &amp;asymp; 0.70 V and I &amp;asymp; 13 mA&lt;/li&gt;
&lt;li&gt;The voltage stays almost constant while the current rises&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class=&quot;ch-col red&quot;&gt;
&lt;h3&gt;Reverse breakdown (V &amp;lt; &amp;minus;V&lt;sub&gt;z&lt;/sub&gt;)&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;$I_{br} = I_{bv}\, e^{-(V+V_z)/(N_z V_t)}$ plus the term $(|V|-V_z)/R_z$ beyond the knee&lt;/li&gt;
&lt;li&gt;At &amp;minus;5.1 V the current is exactly &amp;minus;1 mA (the definition of V&lt;sub&gt;z&lt;/sub&gt;)&lt;/li&gt;
&lt;li&gt;At &amp;minus;5.14 V: &amp;minus;10 mA, at &amp;minus;5.22 V: &amp;minus;48 mA&lt;/li&gt;
&lt;li&gt;The voltage hardly changes while the current changes by a factor of 50: this is the &lt;strong&gt;regulation&lt;/strong&gt; property&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;/div&gt;

&lt;div class=&quot;ch-card&quot;&gt;
&lt;h3&gt;Between the two (blocking region)&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;From 0 V down to about &amp;minus;4 V the current is only the leakage (10&lt;sup&gt;&amp;minus;14&lt;/sup&gt; A)&lt;/li&gt;
&lt;li&gt;The knee is rounded: at &amp;minus;5 V the current is already &amp;minus;59 &amp;micro;A&lt;/li&gt;
&lt;li&gt;Dynamic resistance near the test current: $r_z \approx N_z V_t / I = 1.5 \times 25\ mV / 1\ mA \approx 37\ \Omega$, and it falls to a few ohms at higher currents&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;

&lt;h2&gt;How to Run It&lt;/h2&gt;
&lt;div class=&quot;ch-card&quot;&gt;
&lt;ol&gt;
&lt;li&gt;Press &lt;strong&gt;Start Analysis&lt;/strong&gt; in the analysis block (DC Sweep, V1.Vdc from &amp;minus;10 V to 2 V).&lt;/li&gt;
&lt;li&gt;Read V&lt;sub&gt;z&lt;/sub&gt; on the plot: the voltage at which Z1.I reaches &amp;minus;1 mA.&lt;/li&gt;
&lt;li&gt;Use the cursors to measure the slope of the curve in the breakdown region (the dynamic resistance).&lt;/li&gt;
&lt;/ol&gt;
&lt;/div&gt;

&lt;h2&gt;Things to Try&lt;/h2&gt;
&lt;div class=&quot;ch-card&quot;&gt;
&lt;ol&gt;
&lt;li&gt;Set the parameter &lt;em&gt;Vz&lt;/em&gt; of Z1 to 3.3 V (also in the symbol): the breakdown moves to &amp;minus;3.3 V&lt;/li&gt;
&lt;li&gt;Increase &lt;em&gt;Rz&lt;/em&gt; to 20 &amp;Omega;: the curve beyond the knee becomes less steep&lt;/li&gt;
&lt;li&gt;Change &lt;em&gt;Nz&lt;/em&gt; to 3: the knee becomes softer&lt;/li&gt;
&lt;li&gt;Change R1 to 1 k&amp;Omega;: the diode current is limited to a few mA&lt;/li&gt;
&lt;/ol&gt;
&lt;/div&gt;

&lt;div class=&quot;ch-card green-border&quot;&gt;
&lt;h2&gt;Conclusion&lt;/h2&gt;
&lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;The Zener diode behaves like a normal diode in the forward direction (about 0.7 V) and like a voltage reference in the reverse direction: the current can change from 1 mA to 50 mA while the voltage stays between &amp;minus;5.10 V and &amp;minus;5.22 V.&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
"> 
