tyle="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><text class="draggable" name="ref" x="43" y="33" r="0" transform="rotate(0 43 33)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">V1</text><text class="draggable" name="param" x="43" y="42" r="0" transform="rotate(0 43 42)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;" show="Name and value" paramname="Vdc" paramvalue="0V">Vdc=0V</text><polyline points="36,32 14,32 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="10,34 40,34 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="10,30 40,30 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="32,36 18,36 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="25,30 25,22 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline><polyline points="25,45 25,36 " class="polyline" name="polyline" style="stroke: rgb(33, 150, 243); fill: none; stroke-width: 1px;"></polyline></g><g x="75" y="85" transform="translate(75,85)" width="60" height="25" class="part" name="part" xo="0" yo="0" sref="R1" directory="Basic"><g width="350" height="350" zoom="10.799999999999992" left="342" top="142" symbol="{&quot;name&quot;:&quot;Resistor&quot;,&quot;reference&quot;:&quot;R&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;SPICE&quot;,&quot;name&quot;:&quot;Resistor&quot;},&quot;model&quot;:{&quot;name&quot;:&quot;Resistor&quot;,&quot;file&quot;:&quot;Resistor.py&quot;,&quot;dir&quot;:&quot;library&quot;,&quot;local&quot;:true,&quot;setParams&quot;:&quot;R=100Ω&quot;},&quot;description&quot;:{&quot;webPage&quot;:&quot;&quot;,&quot;info&quot;:&quot;&quot;}}"></g><g points="5,15 15,15" class="polyline" name="pin" type="simple" netid="0" netidpos="1"><polyline points="5,15 15,15 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="2" y="12" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="17" y="17" transform="rotate(0 17 17)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none; fill: rgb(0, 0, 0);">p</text><text r="0" x="5" y="15" transform="rotate(0 5 15)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">+</text><ellipse cx="13.5" cy="15" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="15,13.5 15,16.5 16.5,15 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><g points="60,15 50,15" class="polyline" name="pin" type="simple" netid="1" netidpos="0"><polyline points="60,15 50,15 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="57" y="12" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="48" y="17" transform="rotate(0 48 17)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none; fill: rgb(0, 0, 0);">n</text><text r="0" x="60" y="15" transform="rotate(0 60 15)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="51.5" cy="15" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="50,13.5 50,16.5 48.5,15 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="15,15 20,15 23,7 27,21 33,7 37,21 43,7 45,15 51,15 " class="polyline" name="polyline" st