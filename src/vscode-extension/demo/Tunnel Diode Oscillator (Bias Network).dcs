X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="9" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><g x="480" y="105" transform="translate(480,105)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X4" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="10" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><g x="545" y="110" transform="translate(545,110)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X5" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="11" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><text class="draggable" name="text" x="30" y="18" r="0" rtemp="0" transform="rotate(0 30 18)" style="fill: rgb(255, 123, 0); font-weight: normal; font-style: italic; font-size: 14px; font-family: lighter;">Tunnel diode oscillator with bias network</text><text class="draggable" name="text" x="278" y="47" r="0" rtemp="0" transform="rotate(0 278 47)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">A</text><text class="draggable" name="text" x="404" y="47" r="0" rtemp="0" transform="rotate(0 404 47)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">T</text><text class="draggable" name="text" x="100" y="140" r="0" rtemp="0" transform="rotate(0 100 140)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">Bias circuit</text><text class="draggable" name="text" x="455" y="140" r="0" rtemp="0" transform="rotate(0 455 140)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">Tank circuit</text><text class="draggable" name="text" x="560" y="140" r="0" rtemp="0" transform="rotate(0 560 140)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">Load</text><g transform="translate(30,280)" x="30" y="280" width="420" height="230" class="analysis" name="analysis" description="{&quot;type&quot;:&quot;Time Domain&quot;,&quot;title&quot;:&quot;&quot;,&quot;dcsweep&quot;:{&quot;param&quot;:&quot;Non&quot;,&quot;unit&quot;:&quot;&quot;,&quot;start&quot;:&quot;0&quot;,&quot;stop&quot;:&quot;0&quot;,&quot;step&quot;:&quot;0&quot;,&quot;modified&quot;:false},&quot;time&quot;:{&quot;start&quot;:&quot;0s&quot;,&quot;stop&quot;:&quot;2us&quot;,&quot;step&quot;:&quot;0.2ns&quot;,&quot;modified&quot;:false},&quot;ac&quot;:{&quot;start&quot;:&quot;1&quot;,&quot;stop&quot;:&quot;1000&quot;,&quot;step&quot;:&quot;100&quot;,&quot;scale&quot;:&quot;dec&quot;,&quot;type&quot;:&quot;de&quot;,&quot;modified&quot;:false},&quot;yAxe&quot;:[{&quot;name&quot;:&quot;T&quot;,&quot;color&quot;:&quot;#2a73c0&quot;},{&quot;name&quot;:&quot;A&quot;,&quot;color&quot;:&quot;#d33636&quot;}],&quot;xAxe&quot;:{&quot;name&quot;:&quot;None&quot;,&quot;unit&quot;:&quot;&quot;,&quot;type&quot;:&quot;&quot;,&quot;color&quot;:&quot;#000000&quot;,&quot;used&quot;:false},&quot;layout&quot;:{&quot;margin&quot;:{&quot;l&quot;:35,&quot;r&quot;:25,&quot;b&quot;:80,&quot;t&quot;:35},&quot;font&quot;:{&quot;color&quot;:&quot;#333333&quot;,&quot;size&quot;:11,&quot;family&quot;:&quot;Arial&quot;},&quot;paper_bgcolor&quot;:&quot;#ffffff&quot;,&quot;plot_bgcolor&quot;:&quot;#f8f8f8&quot;,&quot;bordercolor&quot;:&quot;#cccccc&quot;,&quot;yaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;xaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;showlegend&quot;:true,&quot;grid&quot;:{&quot;rows&quot;:1,&quot;columns&quot;:1,&quot;pattern&quot;:&quot;independent&quot;,&quot;roworder&quot;:&quot;bottom to top&quot;}},&quot;options&quot;:{&quot;uic&quot;:true,&quot;adaptive&quot;:true,&quot;order&quot;:2},&quot;sweep&quot;:{&quot;param&quot;:&quot;&quot;,&quot;values&quot;:&quot;[]&quot;}}"><foreignObject x="0" y="0" width="420" height="230"><div name="plots" style="border-style: double; transform-origin: 0px 0px; transform: scale(0.6); box-sizing: border-box; border-width: 3px; margin: 0px; padding: 0px; width: 700px; height: 383.333px;" ondblclick="showPlotInModel(this)"></div></foreignObject></g><g transform="translate(640,20)" x="640" y="20" title="codeHTML" width="560" height="773" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="560" height="773" style="width: 560px; height: 773px;"><div name="htmlCode" style="zoom: 0.56; height: 1380.36px; width: 1000px;" code="&lt;div class=&quot;ch&quot;&gt;
&lt;h1&gt;Tunnel Diode Oscillator with a Bias Network&lt;/h1&gt;

&lt;div class=&quot;ch-card&quot;&gt;
&lt;h2&gt;Circuit Components&lt;/h2&gt;
&lt;p&gt;The circuit is drawn in three blocks, as in the classical textbook figure:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Bias circuit:&lt;/strong&gt; battery &lt;em&gt;Vb&lt;/em&gt; = 1.5 V, switch &lt;em&gt;SW&lt;/em&gt; (&lt;em&gt;SwitchSPST&lt;/em&gt;, &lt;em&gt;state&lt;/em&gt; = 1: closed), series resistor &lt;em&gt;R1&lt;/em&gt; = 60 &amp;Omega; and shunt resistor &lt;em&gt;Rs&lt;/em&gt; = 12 &amp;Omega;. They form a voltage divider that sets the operating point of the diode&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Tunnel diode (TD):&lt;/strong&gt; &lt;em&gt;TunnelDiode&lt;/em&gt;, I&lt;sub&gt;p&lt;/sub&gt; = 5 mA at V&lt;sub&gt;p&lt;/sub&gt; = 0.1 V. The anode is on the node &lt;em&gt;A&lt;/em&gt; (the divider) and the cathode on the node &lt;em&gt;T&lt;/em&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Tank circuit:&lt;/strong&gt; &lt;em&gt;Cr&lt;/em&gt; = 100 pF and &lt;em&gt;Lr&lt;/em&gt; = 1 &amp;micro;H in parallel, from &lt;em&gt;T&lt;/em&gt; to ground&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Load:&lt;/strong&gt; &lt;em&gt;RL&lt;/em&gt; = 1 k&amp;Omega; from &lt;em&gt;T&lt;/em&gt; to ground&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;

&lt;h2&gt;Principle&lt;/h2&gt;
&lt;p&gt;Between its peak (0.10 V, 5.00 mA) and its valley (0.43 V, 1.15 mA) the tunnel diode has a &lt;strong&gt;negative resistance&lt;/strong&gt;: the current decreases when the voltage increases. The steepest slope is &amp;minus;18.2 mS, that is &amp;minus;55 &amp;Omega;.&lt;/p&gt;

&lt;div class=&quot;ch-grid&quot;&gt;
&lt;div class=&quot;ch-col blue&quot;&gt;
&lt;h3&gt;DC: the operating point&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;The divider is equivalent to a source $V_{th} = V_b \dfrac{R_s}{R_1 + R_s}$ in series with $R_{th} = R_1 \parallel R_s$&lt;/li&gt;
&lt;li&gt;$V_{th} = 1.5 \times 12 / 72 = \mathbf{0.25\ V}$ and $R_{th} = \mathbf{10\ \Omega}$&lt;/li&gt;
&lt;li&gt;Lr is a short circuit for DC, so the whole $V_{th}$ is applied to the diode through $R_{th}$: it is biased in the middle of the negative-resistance region&lt;/li&gt;
&lt;li&gt;For a stable bias point: $R_{th} &lt; |r_{neg}| \approx 55\ \Omega$&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class=&quot;ch-col red&quot;&gt;
&lt;h3&gt;AC: the oscillation&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;For the high frequencies the battery and the divider are a low impedance: the node &lt;em&gt;A&lt;/em&gt; is an AC ground, in series with $R_{th}$&lt;/li&gt;
&lt;li&gt;So the diode, with a net negative resistance $-(|r| - R_{th})$, is connected across the tank Cr&amp;#8214;Lr and the load RL&lt;/li&gt;
&lt;li&gt;The oscillation starts if this negative resistance compensates the losses of the tank and of the load&lt;/li&gt;
&lt;li&gt;Lr blocks the DC component: the load voltage oscillates around &lt;strong&gt;0 V&lt;/strong&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;/div&gt;

&lt;h2&gt;Results of the Simulation&lt;/h2&gt;
&lt;div class=&quot;ch-formula&quot;&gt;
$f_{sim} \approx \mathbf{12.2\ MHz}$ &amp;nbsp;&amp;nbsp;&amp;nbsp; $V_T:\ -0.32\ V \rightarrow +0.24\ V$ &amp;nbsp;&amp;nbsp;&amp;nbsp; $V_A:\ 0.20\ V \rightarrow 0.25\ V$
&lt;/div&gt;
&lt;ul&gt;
&lt;li&gt;The frequency of the oscillation is &lt;strong&gt;12.20 MHz&lt;/strong&gt;, the same as the oscillator of the demo &lt;em&gt;Tunnel Diode Oscillator&lt;/em&gt;, which has the same diode, L and C&lt;/li&gt;
&lt;li&gt;The voltage on the load &lt;em&gt;T&lt;/em&gt; goes from &lt;strong&gt;&amp;minus;0.319 V to +0.243 V&lt;/strong&gt; and its mean value is 2.5 mV: the signal is centred on zero, as in the figure. The first swing already appears after about 3 ns&lt;/li&gt;
&lt;li&gt;The anode node &lt;em&gt;A&lt;/em&gt; only has a ripple, between &lt;strong&gt;0.199 V and 0.246 V&lt;/strong&gt; (the divider holds it near 0.25 V)&lt;/li&gt;
&lt;li&gt;Current of the coil: between &amp;minus;1.2 mA and +6.2 mA. Current of the diode: between 0.4 mA and 5.1 mA (it stays inside the range of the I(V) curve)&lt;/li&gt;
&lt;/ul&gt;

&lt;h2&gt;Reading the Plot&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;T&lt;/strong&gt;: the output of the oscillator, on the load, centred on 0 V&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;A&lt;/strong&gt;: the node between the divider and the diode, nearly constant: this is the bias&lt;/li&gt;
&lt;/ul&gt;

&lt;h2&gt;How to Run It&lt;/h2&gt;
&lt;div class=&quot;ch-card&quot;&gt;
&lt;p style=&quot;margin: 0;&quot;&gt;Press &lt;strong&gt;Start Analysis&lt;/strong&gt; in the analysis block (Time Domain, 0 to 2 &amp;micro;s, step 0.2 ns; options &lt;em&gt;uic&lt;/em&gt;, &lt;em&gt;adaptive&lt;/em&gt; and &lt;em&gt;order 2&lt;/em&gt;). The switch is closed (&lt;em&gt;state&lt;/em&gt; = 1) at the beginning: the battery is connected at t = 0, which starts the oscillation.&lt;/p&gt;
&lt;/div&gt;

&lt;h2&gt;Things to Try&lt;/h2&gt;
&lt;div class=&quot;ch-card&quot;&gt;
&lt;ol&gt;
&lt;li&gt;Set the &lt;em&gt;state&lt;/em&gt; of SW to 0: the switch is open, nothing is powered and both T and A stay at 0 V&lt;/li&gt;
&lt;li&gt;Set Vb to 3 V: the bias is above the valley and A settles to 0.485 V: no oscillation&lt;/li&gt;
&lt;li&gt;Change R1 to 30 &amp;Omega;: the bias is 0.43 V, at the edge of the negative-resistance region. The oscillation is weak: T between &amp;minus;0.058 V and +0.058 V&lt;/li&gt;
&lt;li&gt;Change R1 to 300 &amp;Omega; and Rs to 60 &amp;Omega; (the same V&lt;sub&gt;th&lt;/sub&gt; = 0.25 V but R&lt;sub&gt;th&lt;/sub&gt; = 50 &amp;Omega;, almost the whole negative resistance): the bias is not stable, A settles to 0.048 V and the oscillation does not start&lt;/li&gt;
&lt;li&gt;Reduce RL to 100 &amp;Omega;: the load takes more of the power; T goes from &amp;minus;0.21 V to +0.17 V and the frequency becomes 13.6 MHz&lt;/li&gt;
&lt;li&gt;Increase Cr to 400 pF: 7.2 MHz. Increase Lr to 4 &amp;micro;H: 4.6 MHz. The frequency follows the tank, the amplitude stays almost the same&lt;/li&gt;
&lt;/ol&gt;
&lt;/div&gt;
&lt;/div&gt;
"> 
    <!-- Parent container that responds to mouse movement -->
    <div class="chtool"> 
        
        <!-- tool bar-->
        <div class="ch-page-toolbar" style="zoom: 1.78571;">
