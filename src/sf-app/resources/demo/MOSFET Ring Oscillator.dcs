                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3 L3 10 V21 H9 V15 H15 V21 H21 V10 Z"></path>
                </svg>
            </button>
            <button class="ch-toolbar-button" title="Modified" onclick="modifyAction()">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
