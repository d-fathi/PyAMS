&quot;setParams&quot;:&quot;C=0.000001F&quot;},&quot;description&quot;:{&quot;webPage&quot;:&quot;&quot;,&quot;info&quot;:&quot;&quot;}}"></g><g points="5,15 15,15" class="polyline" name="pin" type="simple" netid="1" netidpos="0" netId="1" netIdPos="0"><polyline points="5,15 15,15 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="2" y="12" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="17" y="17" transform="rotate(0 17 17)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none; fill: rgb(0, 0, 0);">p</text><text r="0" x="5" y="15" transform="rotate(0 5 15)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">+</text><ellipse cx="13.5" cy="15" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="15,13.5 15,16.5 16.5,15 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><g points="35,15 25,15" class="polyline" name="pin" type="simple" netid="4" netidpos="2" netId="4" netIdPos="2"><polyline points="35,15 25,15 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="32" y="12" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="23" y="17" transform="rotate(0 23 17)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none; fill: rgb(0, 0, 0);">n</text><text r="0" x="35" y="15" transform="rotate(0 35 15)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">-</text><ellipse cx="26.5" cy="15" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="25,13.5 25,16.5 23.5,15 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none