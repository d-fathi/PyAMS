<g width="1500" height="1500" zoom="1.9999999999999993" left="21" top="0" symbol="{&quot;name&quot;:&quot;RLC Band-Pass Filter&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;PyAMS&quot;,&quot;name&quot;:&quot;None&quot;},&quot;model&quot;:{&quot;name&quot;:&quot;None&quot;,&quot;file&quot;:&quot;None&quot;,&quot;dir&quot;:&quot;None&quot;,&quot;local&quot;:false,&quot;setParams&quot;:&quot;&quot;},&quot;description&quot;:{&quot;webPage&quot;:&quot;&quot;,&quot;info&quot;:&quot;&quot;}}"></g><polyline points="215,40 265,40 265,50 " class="polyline" name="net" xdir="false" ref="out" parent="true" parentcolor="false" used="true" id="0" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="null" setref="out"></polyline><polyline points="105,40 60,40 60,60 " class="polyline" name="net" xdir="false" ref="in" parent="true" parentcolor="false" used="true" id="1" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="null" setref="in"></polyline><polyline points="60,110 60,120 265,120 265,105 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="2" node0="-1" node1="-1" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;"></polyline><polyline points="150,140 150,120 150,120 " class="polyline" name="net" xdir="true" ref="0" parent="false" parentcolor="false" used="true" id="3" node0="-1" node1="2" style="stroke: rgb(99, 8, 17); fill: none; stroke-width: 1.3px;" diagonal="false"></polyline><text class="draggable" name="text" x="242" y="33" r="0" rtemp="0" transform="rotate(0 242 33)" style="fill: rgb(255, 123, 0); font-weight: bold; font-style: normal; font-size: 13px; font-family: normal;">out</text><text class="draggable" name="text" x="65" y="33" r="0" rtemp="0" transform="rotate(0 65 33)" style="fill: rgb(255, 123, 0); font-weight: bold; font-style: normal; font-size: 13px; font-family: normal;">in</text><g transform="translate(367,44)" x="367" y="44" title="codeHTML" width="304" height="354" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="304" height="354" style="height: 354px; width: 304px;"><div name="htmlCode" style="zoom: 0.304; height: 1164.47px; width: 1000px;" code="&lt;div class=&quot;ch&quot;&gt;
    
    &lt;h1&gt;Series RLC Band-Pass Filter - PyAMS AC Analysis&lt;/h1&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Circuit Components&lt;/h2&gt;
        &lt;ul&gt;
            &lt;li&gt;&lt;strong&gt;Capacitor (C1):&lt;/strong&gt; 1 &amp;micro;F&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Inductor (L1):&lt;/strong&gt; 10 mH&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Resistor (R1):&lt;/strong&gt; 10 &amp;Omega;&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Input (V1):&lt;/strong&gt; AC Voltage Source (1V amplitude)&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Output:&lt;/strong&gt; Taken across resistor R1&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

    &lt;h2&gt;Resonant Frequency&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        fr = 1 / (2&amp;pi;&amp;radic;(LC)) = 1 / (2&amp;pi;&amp;radic;(10&amp;times;10&amp;minus;3 &amp;times; 1&amp;times;10&amp;minus;6)) &amp;approx; &lt;strong&gt;1592 Hz&lt;/strong&gt;
    &lt;/div&gt;

    &lt;h2&gt;Quality Factor &amp; Bandwidth&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        Q = (1/R)&amp;radic;(L/C) = (1/10)&amp;radic;(10&amp;times;10&amp;minus;3 / 1&amp;times;10&amp;minus;6) = &lt;strong&gt;10&lt;/strong&gt;&lt;br&gt;
        BW = fr / Q = 1592 / 10 &amp;approx; &lt;strong&gt;159 Hz&lt;/strong&gt;
    &lt;/div&gt;

    &lt;h2&gt;Simulation Results&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;

        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Magnitude Response (Black Line)&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Below fr:&lt;/strong&gt; Attenuation increases as frequency decreases (-20 dB/decade)&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;At Resonance (1592 Hz):&lt;/strong&gt; Peak at 0 dB (maximum output)&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Above fr:&lt;/strong&gt; Attenuation increases as frequency increases (-20 dB/decade)&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;Bandwidth:&lt;/strong&gt; Passes frequencies around 1592 Hz (&amp;plusmn;80 Hz)&lt;/li&gt;
                &lt;li&gt;At resonance: XL = XC, circuit is purely resistive&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;Phase Response (Red Line)&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;Low Freq (f &amp;lt; fr):&lt;/strong&gt; +&amp;pi;/2 rad (+90&amp;deg;) - capacitive behavior&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;At Resonance:&lt;/strong&gt; 0 rad (0&amp;deg;) - purely resistive&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;High Freq (f &amp;gt; fr):&lt;/strong&gt; -&amp;pi;/2 rad (-90&amp;deg;) - inductive behavior&lt;/li&gt;
                &lt;li&gt;Sharp phase transition around resonant frequency&lt;/li&gt;
                &lt;li&gt;High Q factor causes steep phase change&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;

    &lt;/div&gt;

    &lt;div class=&quot;ch-card green-border&quot;&gt;
        &lt;h2&gt;Conclusion&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;The circuit functions as a &lt;strong&gt;band-pass filter&lt;/strong&gt; with a resonant frequency of approximately 1592 Hz. At resonance, the inductive and capacitive reactances cancel each other (XL = XC), leaving only the resistance. This results in maximum current flow and maximum voltage across R1. The circuit selectively passes frequencies near the resonant frequency while attenuating both lower and higher frequencies. The quality factor Q=10 indicates a relatively narrow bandwidth and sharp resonance peak.&lt;/p&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card&quot; style=&quot;&quot;&gt;
        &lt;h2 style=&quot;color: #16a085;&quot;&gt;Circuit Behavior Analysis&lt;/h2&gt;
        &lt;ul style=&quot;line-height: 1.6; margin: 0;&quot;&gt;
            &lt;li&gt;&lt;strong&gt;Below resonance:&lt;/strong&gt; Capacitor dominates (high impedance), blocks low frequencies&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;At resonance:&lt;/strong&gt; L and C cancel, minimum impedance (Z = R = 10&amp;Omega;), maximum current&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Above resonance:&lt;/strong&gt; Inductor dominates (high impedance), blocks high frequencies&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Applications:&lt;/strong&gt; Radio tuning, frequency selection, audio equalization&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

&lt;/div&gt;"> 
