ice&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="6" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><text class="draggable" name="text" x="30" y="18" r="0" rtemp="0" transform="rotate(0 30 18)" style="fill: rgb(255, 123, 0); font-weight: normal; font-style: italic; font-size: 14px; font-family: lighter;">Zener diode clipper / voltage limiter (transient)</text><text class="draggable" name="text" x="140" y="92" r="0" rtemp="0" transform="rotate(0 140 92)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">out</text><g transform="translate(30,280)" x="30" y="280" width="420" height="230" class="analysis" name="analysis" description="{&quot;type&quot;:&quot;Time Domain&quot;,&quot;title&quot;:&quot;&quot;,&quot;dcsweep&quot;:{&quot;param&quot;:&quot;Non&quot;,&quot;unit&quot;:&quot;&quot;,&quot;start&quot;:&quot;0&quot;,&quot;stop&quot;:&quot;0&quot;,&quot;step&quot;:&quot;0&quot;,&quot;modified&quot;:false},&quot;time&quot;:{&quot;start&quot;:&quot;0s&quot;,&quot;stop&quot;:&quot;60ms&quot;,&quot;step&quot;:&quot;0.1ms&quot;,&quot;modified&quot;:false},&quot;ac&quot;:{&quot;start&quot;:&quot;1&quot;,&quot;stop&quot;:&quot;1000&quot;,&quot;step&quot;:&quot;100&quot;,&quot;scale&quot;:&quot;dec&quot;,&quot;type&quot;:&quot;de&quot;,&quot;modified&quot;:false},&quot;yAxe&quot;:[{&quot;name&quot;:&quot;vin&quot;,&quot;color&quot;:&quot;#2a73c0&quot;},{&quot;name&quot;:&quot;out&quot;,&quot;color&quot;:&quot;#d33636&quot;}],&quot;xAxe&quot;:{&quot;name&quot;:&quot;None&quot;,&quot;unit&quot;:&quot;&quot;,&quot;type&quot;:&quot;&quot;,&quot;color&quot;:&quot;#000000&quot;,&quot;used&quot;:false},&quot;layout&quot;:{&quot;margin&quot;:{&quot;l&quot;:35,&quot;r&quot;:25,&quot;b&quot;:80,&quot;t&quot;:35},&quot;font&quot;:{&quot;color&quot;:&quot;#333333&quot;,&quot;size&quot;:11,&quot;family&quot;:&quot;Arial&quot;},&quot;paper_bgcolor&quot;:&quot;#ffffff&quot;,&quot;plot_bgcolor&quot;:&quot;#f8f8f8&quot;,&quot;bordercolor&quot;:&quot;#cccccc&quot;,&quot;yaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;xaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;showlegend&quot;:true,&quot;grid&quot;:{&quot;rows&quot;:1,&quot;columns&quot;:1,&quot;pattern&quot;:&quot;independent&quot;,&quot;roworder&quot;:&quot;bottom to top&quot;}},&quot;options&quot;:{},&quot;sweep&quot;:{&quot;param&quot;:&quot;&quot;,&quot;values&quot;:&quot;[]&quot;}}"><foreignObject x="0" y="0" width="420" height="230"><div name="plots" style="border-style: double; transform-origin: 0px 0px; transform: scale(0.6); box-sizing: border-box; border-width: 3px; margin: 0px; padding: 0px; width: 700px; height: 383.333px;" ondblclick="showPlotInModel(this)"></div></foreignObject></g><g transform="translate(470,20)" x="470" y="20" title="codeHTML" width="560" height="693" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="560" height="693" style="width: 560px; height: 693px;"><div name="htmlCode" style="zoom: 0.56; height: 1237.5px; width: 1000px;" code="&lt;div class=&quot;ch&quot;&gt;
&lt;h1&gt;Zener Diode Clipper / Voltage Limiter (Transient)&lt;/h1&gt;

&lt;div class=&quot;ch-card&quot;&gt;
&lt;h2&gt;Circuit Components&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Source (V1):&lt;/strong&gt; 50 Hz sine wave, 15 V peak&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Resistor (R1):&lt;/strong&gt; 330 &amp;Omega;, series resistor that takes the excess voltage&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Zener diode (Z1):&lt;/strong&gt; &lt;em&gt;ZenerDiode&lt;/em&gt;, V&lt;sub&gt;z&lt;/sub&gt; = 5.1 V. The cathode is on the node &lt;em&gt;out&lt;/em&gt; and the anode on ground&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Load (R2):&lt;/strong&gt; 1 k&amp;Omega; in parallel with the diode&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;

&lt;h2&gt;Principle&lt;/h2&gt;
&lt;p&gt;The diode is connected in the reverse direction for the positive voltages. It limits the output to V&lt;sub&gt;z&lt;/sub&gt; in the positive half-cycle and to one forward drop in the negative half-cycle, so it clips the two peaks of the sine wave at different levels.&lt;/p&gt;

&lt;div class=&quot;ch-grid&quot;&gt;
&lt;div class=&quot;ch-col red&quot;&gt;
&lt;h3&gt;Positive half-cycle: breakdown&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;While v&lt;sub&gt;in&lt;/sub&gt; is below about 5 V the diode is blocked and out follows the divider R1 / R2&lt;/li&gt;
&lt;li&gt;Above that, Z1 goes into breakdown and holds out near V&lt;sub&gt;z&lt;/sub&gt;&lt;/li&gt;
&lt;li&gt;Peak of out: &lt;strong&gt;5.18 V&lt;/strong&gt; (V&lt;sub&gt;z&lt;/sub&gt; plus the small drop of R&lt;sub&gt;z&lt;/sub&gt;)&lt;/li&gt;
&lt;li&gt;The excess voltage drops across R1: $I_{R1} \approx (15 - 5.18)/330 \approx 30\ mA$&lt;/li&gt;
&lt;li&gt;Current in Z1 (reverse): about 25 mA at the peak&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class=&quot;ch-col blue&quot;&gt;
&lt;h3&gt;Negative half-cycle: forward&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Z1 behaves as a normal diode&lt;/li&gt;
&lt;li&gt;out is clamped at about &lt;strong&gt;&amp;minus;0.73 V&lt;/strong&gt;&lt;/li&gt;
&lt;li&gt;Current in Z1 (forward): about 42 mA at the peak&lt;/li&gt;
&lt;li&gt;$I \approx (15 - 0.73)/330 \approx 43\ mA$ minus the load current&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;/div&gt;

&lt;div class=&quot;ch-formula&quot;&gt;
$V_{out}^{+} \approx V_z + R_z\, I_z \approx \mathbf{5.2\ V}$ &amp;nbsp;&amp;nbsp;&amp;nbsp; $V_{out}^{-} \approx -V_F \approx \mathbf{-0.73\ V}$ &amp;nbsp;&amp;nbsp;&amp;nbsp; $P_z \approx V_z \times I_z \approx 5.18 \times 25\ mA \approx 130\ mW$
&lt;/div&gt;

&lt;h2&gt;Reading the Plot&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;vin&lt;/strong&gt;: the 15 V sine wave&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;out&lt;/strong&gt;: the clipped wave, between &amp;minus;0.73 V and +5.18 V. The positive plateau is flat: this is the regulation effect of the breakdown&lt;/li&gt;
&lt;/ul&gt;

&lt;h2&gt;How to Run It&lt;/h2&gt;
&lt;div class=&quot;ch-card&quot;&gt;
&lt;p style=&quot;margin: 0;&quot;&gt;Press &lt;strong&gt;Start Analysis&lt;/strong&gt; in the analysis block (Time Domain, 0 to 60 ms, step 0.1 ms: three periods of the source).&lt;/p&gt;
&lt;/div&gt;

&lt;h2&gt;Things to Try&lt;/h2&gt;
&lt;div class=&quot;ch-card&quot;&gt;
&lt;ol&gt;
&lt;li&gt;Set &lt;em&gt;Vz&lt;/em&gt; to 3.3 V (also in the symbol): the positive clip level becomes about 3.4 V&lt;/li&gt;
&lt;li&gt;Change R2 to 100 k&amp;Omega;: the clip level is almost unchanged (5.19 V), only a little less current flows in the load&lt;/li&gt;
&lt;li&gt;Change R1 to 100 &amp;Omega;: the current in Z1 reaches 142 mA, the clip level rises slightly (5.25 V) and the diode dissipates much more power&lt;/li&gt;
&lt;li&gt;Replace V1 by a DC source with a ripple: the same circuit works as a shunt voltage regulator&lt;/li&gt;
&lt;/ol&gt;
&lt;/div&gt;

&lt;div class=&quot;ch-card green-border&quot;&gt;
&lt;h2&gt;Conclusion&lt;/h2&gt;
&lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;A single Zener diode with a series resistor limits a 15 V peak signal to the range &amp;minus;0.73 V to +5.18 V. The reverse breakdown fixes the upper level at V&lt;sub&gt;z&lt;/sub&gt; and the forward junction fixes the lower level near &amp;minus;0.7 V.&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
"> 
