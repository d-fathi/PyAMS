ss="cartesianlayer"><g class="subplot xy"><g class="layer-subplot"><g class="shapelayer"></g><g class="imagelayer"></g></g><g class="gridlayer"><g class="x"><path class="xgrid crisp" transform="translate(135.48000000000002,0)" d="M0,35v466" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path><path class="xgrid crisp" transform="translate(242.89,0)" d="M0,35v466" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path></g><g class="y"><path class="ygrid crisp" transform="translate(0,489.1)" d="M70,0h319" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path><path class="ygrid crisp" transform="translate(0,437.07)" d="M70,0h319" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path><path class="ygrid crisp" transform="translate(0,385.04)" d="M70,0h319" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path><path class="ygrid crisp" transform="translate(0,333.01)" d="M70,0h319" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path><path class="ygrid crisp" transform="translate(0,280.97)" d="M70,0h319" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path><path class="ygrid crisp" transform="translate(0,176.91)" d="M70,0h319" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path><path class="ygrid crisp" transform="translate(0,124.88)" d="M70,0h319" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path><path class="ygrid crisp" transform="translate(0,72.84)" d="M70,0h319" style="stroke: rgb(224, 224, 224); stroke-opacity: 1; stroke-width: 1px;"></path></g></g><g class="zerolinelayer"><path class="xzl zl crisp" transform="translate(350.31,0)" d="M0,35v466" style="stroke: rgb(68, 68, 68); stroke-opacity: 1; stroke-width: 1px;"></path><path class="yzl zl crisp" transform="translate(0,228.94)" d="M70,0h319" style="stroke: rgb(68, 68, 68); stroke-opacity: 1; stroke-width: 1px;"></path></g><path class="xlines-below"></path><path class="ylines-below"></path><g class="overlines-below"></g><g class="xaxislayer-below"></g><g class="yaxislayer-below"></g><g class="overaxes-below"></g><g class="plot" transform="translate(70,35)" clip-path="url('#clip09d441xyplot')"><g class="scatterlayer mlayer"><g class="trace scatter trace067add" style="stroke-miterlimit: 2; opacity: 1;"><g class="fills"></g><g class="errorbars"></g><g class="lines"><path class="js-line" d="M0,442.7L2.2,317.35L2.26,314.81L4.89,234.11L4.99,231.6L6.4,199.14L7.24,197.36L9.99,194.82L12.09,194.25L22.51,193.94L25.2,193.94L309.67,193.78L311.74,193.18L313.91,190.08L314.48,188.03L315.74,178.84L315.94,176.43L317.13,151.57L317.21,149.04L318.52,74.86L318.55,72.29L319,23.3" style="vector-effect: non-scaling-stroke; fill: none; stroke: rgb(211, 54, 54); stroke-opacity: 1; stroke-width: 1.5px; opacity: 1;"></path></g><g class="points"></g><g class="text"></g></g></g></g><g class="overplot"></g><path class="xlines-above crisp" d="M0,0" style="fill: none;"></path><path class="ylines-above crisp" d="M0,0" style="fill: none;"></path><g class="overlines-above"></g><g class="xaxislayer-above"><g class="xtick"><text text-anchor="middle" x="0" y="513" data-unformatted="−4V" data-math="N" transform="translate(135.48000000000002,0)" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">−4V</text></g><g class="xtick"><text text-anchor="middle" x="0" y="513" data-unformatted="−2V" data-math="N" transform="translate(242.89,0)" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">−2V</text></g><g class="xtick"><text text-anchor="middle" x="0" y="513" data-unformatted="0V" data-math="N" transform="translate(350.31,0)" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">0V</text></g></g><g class="yaxislayer-above"><g cl