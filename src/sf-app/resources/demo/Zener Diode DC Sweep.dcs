: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">0.02</text></g><g class="ytick"><text text-anchor="end" x="69" y="3.8499999999999996" data-unformatted="0.03" data-math="N" transform="translate(0,72.84)" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">0.03</text></g></g><g class="overaxes-above"></g></g></g><g class="polarlayer"></g><g class="ternarylayer"></g><g class="geolayer"></g><g class="funnelarealayer"></g><g class="pielayer"></g><g class="treemaplayer"></g><g class="sunburstlayer"></g><g class="glimages"></g></svg><div class="gl-container"></div><svg class="main-svg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="489" height="570.6666666666667"><defs id="topdefs-09d441"><g class="clips"></g><clipPath id="legend09d441"><rect width="82" height="29" x="0" y="0"></rect></clipPath></defs><g class="indicatorlayer"></g><g class="layer-above"><g class="imagelayer"></g><g class="shapelayer"></g></g><g class="infolayer"><g class="legend" pointer-events="all" transform="translate(395.38,35)"><rect class="bg" shape-rendering="crispEdges" width="82" height="29" x="0" y="0" style="stroke: rgb(68, 68, 68); stroke-opacity: 1; fill: rgb(255, 255, 255); fill-opacity: 1; stroke-width: 0px;"></rect><g class="scrollbox" transform="" clip-path="url('#legend09d441')"><g class="groups" transform=""><g class="traces" transform="translate(0,14.5)" style="opacity: 1;"><text class="legendtext" text-anchor="start" x="40" y="4.29" data-unformatted="Z1.I [A]" data-math="N" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">Z1.I [A]</text><g class="layers" style="opacity: 1;"><g class="legendfill"></g><g class="legendlines"><path class="js-line" d="M5,0h30" style="fill: none; stroke: rgb(211, 54, 54); stroke-opacity: 1; stroke-width: 1.5px;"></path></g><g class="legendsymbols"><g class="legendpoints"></g></g></g><rect class="legendtoggle" p