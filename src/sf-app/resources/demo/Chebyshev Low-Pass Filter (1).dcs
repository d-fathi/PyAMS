        <span><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.8333em; vertical-align: -0.15em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.0715em;">C</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3011em;"><span class="" style="top: -2.55em; margin-left: -0.0715em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">1</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 2.0908em; vertical-align: -0.7693em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 1.3214em;"><span class="" style="top: -2.314em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord">1000</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">×</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mord">6283</span></span></span><span class="" style="top: -3.23em;"><span class="pstrut" style="height: 3em;"></span><span class="frac-line" style="border-bottom-width: 0.04em;"></span></span><span class="" style="top: -3.677em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord">2.1349</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.7693em;"><span class=""></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">≈</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord">340</span><span class="mspace">&nbsp;</span><span class="mord"><span class="mord mathrm">nF</span></span></span></span></span></span> ,
        <span><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.8333em; vertical-align: -0.15em;"></span><span class="mord"><span class="mord mathnormal">L</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3011em;"><span class="" style="top: -2.55em; margin-left: 0em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">2</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 2.0074em; vertical-align: -0.686em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 1.3214em;"><span class="" style="top: -2.314em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord">6283</span></span></span><span class="" style="top: -3.23em;"><span class="pstrut" style="height: 3em;"></span><span class="frac-line" style="border-bottom-width: 0.04em;"></span></span><span class="" style="top: -3.677em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord">1.0911</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">×</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mord">1000</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.686em;"><span class=""></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">≈</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord">174</span><span class="mspace">&nbsp;</span><span class="mord"><span class="mord mathrm">mH</span></span></span></span></span></span> ,
        <span><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.8333em; vertical-align: -0.15em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.0715em;">C</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3011em;"><span class="" style="top: -2.55em; margin-left: -0.0715em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight">3</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 2.0908em; vertical-align: -0.7693em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 1.3214em;"><span class="" style="top: -2.314em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord">1000</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">×</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mord">6283</span></span></span><span class="" style="top: -3.23em;"><span class="pstrut" style="height: 3em;"></span><span class="frac-line" style="border-bottom-width: 0.04em;"></span></span><span class="" style="top: -3.677em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord">3.0009</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.7693em;"><span class=""></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">≈</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord">478</span><span class="mspace">&nbsp;</span><span class="mord"><span class="mord mathrm">nF</span></span></span></span></span></span>
    </div>

    <h2>How the Circuit Works</h2>
    <div class="ch-grid">
        <div class="ch-col blue">
            <h3>Low Frequencies</h3>
            <ul>
                <li>An inductor behaves like a short wire (XL = ωL is small).</li>
                <li>A capacitor behaves like an open circuit (XC = 1/ωC is large).</li>
                <li>The signal reaches the load through the divider Rs and RL:</li>
                <li><span><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 2.1963em; vertical-align: -0.836em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 1.3603em;"><span class="" style="top: -2.314em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3117em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">in</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span></span></span><span class="" style="top: -3.23em;"><span class="pstrut" style="height: 3em;"></span><span class="frac-line" style="border-bottom-width: 0.04em;"></span></span><span class="" style="top: -3.677em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.2806em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">o</span><span class="mord mathnormal mtight">u</span><span class="mord mathnormal mtight">t</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.836em;"><span class=""></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 2.1963em; vertical-align: -0.836em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 1.3603em;"><span class="" style="top: -2.314em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord"><span class="mord mathnormal" style="margin-right: 0.0077em;">R</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.1514em;"><span class="" style="top: -2.55em; margin-left: -0.0077em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight">s</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.0077em;">R</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3283em;"><span class="" style="top: -2.55em; margin-left: -0.0077em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight">L</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span></span></span><span class="" style="top: -3.23em;"><span class="pstrut" style="height: 3em;"></span><span class="frac-line" style="border-bottom-width: 0.04em;"></span></span><span class="" style="top: -3.677em;"><span class="pstrut" style="height: 3em;"></span><span class="mord"><span class="mord"><span class="mord mathnormal" style="margin-right: 0.0077em;">R</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3283em;"><span class="" style="top: -2.55em; margin-left: -0.0077em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight">L</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.836em;"><span class=""></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6444em;"></span><span class="mord">0.5</span></span></span></span></span>, i.e. <strong>−6.02 dB</strong>.</li>
            </ul>
        </div>
        <div class="ch-col red">
            <h3>High Frequencies</h3>
            <ul>
                <li>The inductors present a large impedance and block the signal.</li>
                <li>The capacitors present a small impedance and shunt the signal to ground.</li>
                <li>Each reactive element adds 20 dB/decade, so 5 elements give <strong>−100 dB/decade</strong>.</li>
            </ul>
        </div>
    </div>
    <p style="line-height: 1.6;">Near fc the inductors and capacitors resonate, which produces <strong>5 equal peaks and dips</strong> in the passband (the count equals the filter order). Equal Rs and RL are required by the design of an odd-order, symmetrically terminated filter.</p>

    <h2>Simulation Results (AC Analysis)</h2>
    <div class="ch-grid">
        <div class="ch-col blue">
            <h3>Passband (up to 1 kHz)</h3>
            <ul>
                <li>Gain stays between <strong>−6.02 dB</strong> and <strong>−7.09 dB</strong>.</li>
                <li>Ripple ≈ <strong>1.06 dB</strong> (slightly above 1 dB because the component values are rounded).</li>
                <li>At 1 kHz: −7.09 dB (the edge of the ripple band).</li>
            </ul>
        </div>
        <div class="ch-col red">
            <h3>Stopband</h3>
            <ul>
                <li><strong>1.1 kHz:</strong> −14 dB</li>
                <li><strong>1.5 kHz:</strong> −36.5 dB</li>
                <li><strong>2 kHz:</strong> −51 dB</li>
                <li><strong>5 kHz:</strong> −94 dB</li>
                <li><strong>10 kHz:</strong> −124 dB</li>
            </ul>
        </div>
    </div>

    <div class="ch-card green-border">
        <h2>Conclusion</h2>
        <p style="line-height: 1.6; margin: 0;">The schematic works as a low-pass filter with a 1 kHz cutoff and 1 dB passband ripple, and the gain falls sharply beyond the cutoff (more than 36 dB down at 1.5 kHz). The price is the passband ripple and a <strong>non-linear phase</strong>: the group delay peaks near fc, which causes ringing in the step response. A Chebyshev filter is therefore preferred when the steepness of the cutoff matters more than phase fidelity, for example in anti-aliasing filters before an ADC, audio crossovers and communication systems.</p>
    </div>

    <div class="ch-card">
        <h2>Try It Yourself</h2>
        <ul style="line-height: 1.6; margin: 0;">
            <li>Run the <strong>AC analysis</strong> (100 Hz to 10 kHz) and watch the <strong>out</strong> curve in dB.</li>
            <li>To move the cutoff to fc2, multiply every L and C value by the ratio 1 kHz / fc2.</li>
            <li>Change RL (for example to 500 Ω) to see how a load mismatch changes the gain and the ripple.</li>
            <li>Change one capacitor or inductor slightly to see how sensitive the response is to component values.</li>
        </ul>
    </div>

</div>

    </div>
    </div></foreignObject></g><g transform="translate(30,225)" x="30" y="225" width="440" height="240" class="analysis" name="analysis" description="{&quot;type&quot;:&quot;AC Analysis&quot;,&quot;title&quot;:&quot;&quot;,&quot;dcsweep&quot;:{&quot;param&quot;:&quot;Non&quot;,&quot;unit&quot;:&quot;&quot;,&quot;start&quot;:&quot;0&quot;,&quot;stop&quot;:&quot;0&quot;,&quot;step&quot;:&quot;0&quot;,&quot;modified&quot;:false},&quot;time&quot;:{&quot;start&quot;:&quot;0s&quot;,&quot;stop&quot;:&quot;20ms&quot;,&quot;step&quot;:&quot;0.01ms&quot;,&quot;modified&quot;:false},&quot;ac&quot;:{&quot;start&quot;:&quot;100&quot;,&quot;stop&quot;:&quot;10K&quot;,&quot;step&quot;:&quot;100&quot;,&quot;scale&quot;:&quot;dec&quot;,&quot;type&quot;:&quot;de&quot;,&quot;modified&quot;:false},&quot;yAxe&quot;:[{&quot;name&quot;:&quot;out&quot;,&quot;color&quot;:&quot;#c83737&quot;}],&quot;xAxe&quot;:{&quot;name&quot;:&quot;None&quot;,&quot;unit&quot;:&quot;&quot;,&quot;type&quot;:&quot;&quot;,&quot;color&quot;:&quot;#000000&quot;,&quot;used&quot;:false},&quot;layout&quot;:{&quot;margin&quot;:{&quot;l&quot;:35,&quot;r&quot;:25,&quot;b&quot;:80,&quot;t&quot;:35},&quot;font&quot;:{&quot;color&quot;:&quot;#333333&quot;,&quot;size&quot;:11,&quot;family&quot;:&quot;Arial&quot;},&quot;paper_bgcolor&quot;:&quot;#ffffff&quot;,&quot;plot_bgcolor&quot;:&quot;#f8f8f8&quot;,&quot;bordercolor&quot;:&quot;#cccccc&quot;,&quot;yaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;xaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;showlegend&quot;:true,&quot;grid&quot;:{&quot;rows&quot;:1,&quot;columns&quot;:1,&quot;pattern&quot;:&quot;independent&quot;,&quot;roworder&quot;:&quot;bottom to top&quot;}},&quot;options&quot;:{},&quot;sweep&quot;:{&quot;param&quot;:&quot;&quot;,&quot;values&quot;:&quot;[]&quot;}}"><foreignObject x="0" y="0" width="440" height="240