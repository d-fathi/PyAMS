quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="11" netidpos="0" netId="10" netIdPos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><g transform="translate(500,20)" x="500" y="20" title="codeHTML" width="340" height="560" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="340" height="560" style="height: 560px; width: 340px;"><div name="htmlCode" style="zoom: 0.34; height: 1647.06px; width: 1000px;" code="&lt;div class=&quot;ch&quot;&gt;

    &lt;h1&gt;5th-Order Chebyshev Low-Pass Filter (1 dB ripple, fc = 1 kHz)&lt;/h1&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Overview&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;This circuit is a &lt;strong&gt;low-pass filter&lt;/strong&gt;: it passes frequencies below the cutoff &lt;strong&gt;fc = 1 kHz&lt;/strong&gt; and attenuates everything above it. It is a &lt;strong&gt;Chebyshev Type I&lt;/strong&gt; design, which has an &lt;strong&gt;equiripple 1 dB variation&lt;/strong&gt; in the passband and a monotonic (ripple-free) stopband. Compared with a Butterworth filter of the same order, it gives a &lt;strong&gt;much steeper roll-off&lt;/strong&gt; past the cutoff, at the price of a small ripple in the passband.&lt;/p&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Circuit Components&lt;/h2&gt;
        &lt;ul style=&quot;line-height: 1.6; margin: 0;&quot;&gt;
            &lt;li&gt;&lt;strong&gt;Vs:&lt;/strong&gt; AC voltage source, 1 V amplitude (input, node &lt;em&gt;in&lt;/em&gt;).&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;Rs = 1 K&amp;Omega;:&lt;/strong&gt; source resistance (first termination of the doubly terminated ladder).&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;C1 = 340 nF, C3 = 478 nF, C5 = 340 nF:&lt;/strong&gt; shunt capacitors that divert high frequencies to ground.&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;L2 = 174 mH, L4 = 174 mH:&lt;/strong&gt; series inductors that block high frequencies.&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;RL = 1 K&amp;Omega;:&lt;/strong&gt; load resistor at the output (node &lt;em&gt;out&lt;/em&gt;).&lt;/li&gt;
            &lt;li&gt;&lt;strong&gt;GND:&lt;/strong&gt; ground (node 0). The circuit nodes are in, n1, n2 and out.&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

    &lt;h2&gt;Design Method&lt;/h2&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        $$|H(j\omega)|^2 = \dfrac{1}{1+\varepsilon^2\,T_5^2(\omega/\omega_c)}, \qquad T_5(x)=16x^5-20x^3+5x$$
        $$\varepsilon=\sqrt{10^{R_p/10}-1}=\sqrt{10^{0.1}-1}\approx 0.509 \quad (R_p = 1\ \mathrm{dB})$$
    &lt;/div&gt;
    &lt;p style=&quot;line-height: 1.6;&quot;&gt;The standard ladder prototype values for 1 dB ripple and order 5 are &lt;strong&gt;g1 ... g5 = 2.1349, 1.0911, 3.0009, 1.0911, 2.1349&lt;/strong&gt; (with g6 = 1 for the load). They are scaled to the real impedance R = 1 k&amp;Omega; and the cutoff frequency:&lt;/p&gt;
    &lt;div class=&quot;ch-formula&quot;&gt;
        $$C_k=\dfrac{g_k}{R\,\omega_c},\qquad L_k=\dfrac{g_k\,R}{\omega_c},\qquad \omega_c=2\pi\cdot 1000 \approx 6283\ \mathrm{rad/s}$$
        $C_1 = \dfrac{2.1349}{1000\times 6283}\approx 340\ \mathrm{nF}$ ,
        $L_2 = \dfrac{1.0911\times 1000}{6283}\approx 174\ \mathrm{mH}$ ,
        $C_3 = \dfrac{3.0009}{1000\times 6283}\approx 478\ \mathrm{nF}$
    &lt;/div&gt;

    &lt;h2&gt;How the Circuit Works&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;
        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Low Frequencies&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;An inductor behaves like a short wire (XL = &amp;omega;L is small).&lt;/li&gt;
                &lt;li&gt;A capacitor behaves like an open circuit (XC = 1/&amp;omega;C is large).&lt;/li&gt;
                &lt;li&gt;The signal reaches the load through the divider Rs and RL:&lt;/li&gt;
                &lt;li&gt;$\dfrac{V_{out}}{V_{in}}=\dfrac{R_L}{R_s+R_L}=0.5$, i.e. &lt;strong&gt;&amp;minus;6.02 dB&lt;/strong&gt;.&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;
        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;High Frequencies&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;The inductors present a large impedance and block the signal.&lt;/li&gt;
                &lt;li&gt;The capacitors present a small impedance and shunt the signal to ground.&lt;/li&gt;
                &lt;li&gt;Each reactive element adds 20 dB/decade, so 5 elements give &lt;strong&gt;&amp;minus;100 dB/decade&lt;/strong&gt;.&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;p style=&quot;line-height: 1.6;&quot;&gt;Near fc the inductors and capacitors resonate, which produces &lt;strong&gt;5 equal peaks and dips&lt;/strong&gt; in the passband (the count equals the filter order). Equal Rs and RL are required by the design of an odd-order, symmetrically terminated filter.&lt;/p&gt;

    &lt;h2&gt;Simulation Results (AC Analysis)&lt;/h2&gt;
    &lt;div class=&quot;ch-grid&quot;&gt;
        &lt;div class=&quot;ch-col blue&quot;&gt;
            &lt;h3&gt;Passband (up to 1 kHz)&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;Gain stays between &lt;strong&gt;&amp;minus;6.02 dB&lt;/strong&gt; and &lt;strong&gt;&amp;minus;7.09 dB&lt;/strong&gt;.&lt;/li&gt;
                &lt;li&gt;Ripple &amp;asymp; &lt;strong&gt;1.06 dB&lt;/strong&gt; (slightly above 1 dB because the component values are rounded).&lt;/li&gt;
                &lt;li&gt;At 1 kHz: &amp;minus;7.09 dB (the edge of the ripple band).&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;
        &lt;div class=&quot;ch-col red&quot;&gt;
            &lt;h3&gt;Stopband&lt;/h3&gt;
            &lt;ul&gt;
                &lt;li&gt;&lt;strong&gt;1.1 kHz:&lt;/strong&gt; &amp;minus;14 dB&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;1.5 kHz:&lt;/strong&gt; &amp;minus;36.5 dB&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;2 kHz:&lt;/strong&gt; &amp;minus;51 dB&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;5 kHz:&lt;/strong&gt; &amp;minus;94 dB&lt;/li&gt;
                &lt;li&gt;&lt;strong&gt;10 kHz:&lt;/strong&gt; &amp;minus;124 dB&lt;/li&gt;
            &lt;/ul&gt;
        &lt;/div&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card green-border&quot;&gt;
        &lt;h2&gt;Conclusion&lt;/h2&gt;
        &lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;The schematic works as a low-pass filter with a 1 kHz cutoff and 1 dB passband ripple, and the gain falls sharply beyond the cutoff (more than 36 dB down at 1.5 kHz). The price is the passband ripple and a &lt;strong&gt;non-linear phase&lt;/strong&gt;: the group delay peaks near fc, which causes ringing in the step response. A Chebyshev filter is therefore preferred when the steepness of the cutoff matters more than phase fidelity, for example in anti-aliasing filters before an ADC, audio crossovers and communication systems.&lt;/p&gt;
    &lt;/div&gt;

    &lt;div class=&quot;ch-card&quot;&gt;
        &lt;h2&gt;Try It Yourself&lt;/h2&gt;
        &lt;ul style=&quot;line-height: 1.6; margin: 0;&quot;&gt;
            &lt;li&gt;Run the &lt;strong&gt;AC analysis&lt;/strong&gt; (100 Hz to 10 kHz) and watch the &lt;strong&gt;out&lt;/strong&gt; curve in dB.&lt;/li&gt;
            &lt;li&gt;To move the cutoff to fc2, multiply every L and C value by the ratio 1 kHz / fc2.&lt;/li&gt;
            &lt;li&gt;Change RL (for example to 500 &amp;Omega;) to see how a load mismatch changes the gain and the ripple.&lt;/li&gt;
            &lt;li&gt;Change one capacitor or inductor slightly to see how sensitive the response is to component values.&lt;/li&gt;
        &lt;/ul&gt;
    &lt;/div&gt;

&lt;/div&gt;
"> 
