="var" name="ref" x="28" y="17" r="0" rtemp="0" transform="rotate(0 28 17)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;">R2</text><text class="var" name="param" x="24" y="33" r="0" rtemp="0" transform="rotate(0 24 33)" style="fill: rgb(17, 162, 41); font-size: 10px; font-family: &quot;Times New Roman&quot;;" show="Name and value" paramname="R" paramvalue="5KΩ">R=5KΩ</text></g><g x="65" y="105" transform="translate(65,105)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X1" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="4" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><g x="325" y="135" transform="translate(325,135)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X1" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="5" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><g x="385" y="160" transform="translate(385,160)" width="25" height="15" class="part" name="part" xo="0" yo="0" sref="X1" directory="std"><g width="150" top="572" left="0" height="150" zoom="20" symbol="{&quot;name&quot;:&quot;GND&quot;,&quot;reference&quot;:&quot;X&quot;,&quot;device&quot;:{&quot;type&quot;:&quot;std&quot;,&quot;name&quot;:&quot;GND&quot;}}"></g><polyline points="9,12 21,12 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><polyline points="13,14 17,14 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline><g points="15,5 15,10" class="polyline" name="pin" type="simple" netid="6" netidpos="0"><polyline points="15,5 15,10 " style="stroke: rgb(255, 0, 0); stroke-width: 1px;"></polyline><rect width="6" height="6" class="pin" x="12" y="2" style="stroke: rgb(0, 255, 0); fill: none; stroke-width: 1px; display: none;"></rect><text r="0" x="13" y="12" transform="rotate(90 13 12)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;">p</text><text r="0" x="15" y="5" transform="rotate(0 15 5)" style="font-size: 12px; font-family: &quot;Times New Roman&quot;; display: none;"> </text><ellipse cx="15" cy="8.5" rx="1.5" ry="1.5" style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></ellipse><polygon points="13.5,10 16.5,10 15,11.5 " style="stroke: rgb(255, 0, 0); fill: rgb(255, 0, 0); stroke-width: 1px; display: none;"></polygon></g><polyline points="7,10 23,10 " class="polyline" name="polyline" style="stroke: #2196f3; fill: none; stroke-width: 1px;"></polyline></g><text class="draggable" name="text" x="40" y="18" r="0" rtemp="0" transform="rotate(0 40 18)" style="fill: rgb(255, 123, 0); font-weight: normal; font-style: italic; font-size: 14px; font-family: lighter;">RC charge / discharge with an SPST switch (Live simulation)</text><text class="draggable" name="text" x="40" y="30" r="0" rtemp="0" transform="rotate(0 40 30)" style="fill: rgb(100, 116, 139); font-weight: normal; font-style: italic; font-size: 9px; font-family: lighter;">Click the switch: closed = charge, open = discharge.</text><g name="liveScope" class="liveScope" x="470" y="50" width="300" height="200" transform="translate(470,50)" scope="{&quot;mode&quot;:&quot;YT&quot;,&quot;timeDiv&quot;:0.25,&quot;trigger&quot;:{&quot;mode&quot;:&quot;off&quot;,&quot;source&quot;:0,&quot;level&quot;:0,&quot;edge&quot;:&quot;rise&quot;},&quot;grid&quot;:true,&quot;labels&quot;:true,&quot;dark&quot;:true,&quot;lineWidth&quot;:1.5,&quot;channels&quot;:[{&quot;on&quot;:true,&quot;signal&quot;:&quot;vc&quot;,&quot;kind&quot;:&quot;voltage&quot;,&quot;color&quot;:&quot;#3b82f6&quot;,&quot;vdiv&quot;:2,&quot;offset&quot;:0,&quot;invert&quot;:false},{&quot;on&quot;:true,&quot;signal&quot;:&quot;vsw&quot;,&quot;kind&quot;:&quot;voltage&quot;,&quot;color&quot;:&quot;#f59e0b&quot;,&quot;vdiv&quot;:2,&quot;offset&quot;:0,&quot;invert&quot;:false}]}"><foreignObject x="0" y="0" width="300" height="200"><canvas class="liveScopeCanvas" style="width: 300px; height: 200px; display: block;"></canvas></foreignObject></g><g transform="translate(40,280)" x="40" y="280" title="codeHTML" width="730" height="904" class="codeHTML" name="codeHTML" rot="0"><foreignObject x="0" y="0" width="730" height="904" style="width: 730px; height: 904px;"><div name="htmlCode" style="zoom: 0.73; height: 1238.36px; width: 1000px;" code="&lt;div class=&quot;ch&quot;&gt;
&lt;h1&gt;RC Charge / Discharge with an SPST Switch&lt;/h1&gt;

&lt;div class=&quot;ch-card&quot;&gt;
&lt;h2&gt;Circuit Components&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Source (V1):&lt;/strong&gt; DC voltage source, 10 V&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Switch (SW1):&lt;/strong&gt; SPST manual switch between V1 and R1&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Resistor (R1):&lt;/strong&gt; 1 k&amp;Omega; (charging resistor)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Capacitor (C1):&lt;/strong&gt; 100 &amp;micro;F, initially discharged&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Resistor (R2):&lt;/strong&gt; 5 k&amp;Omega;, always connected across C1 (discharge path)&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;

&lt;h2&gt;Why R2 Is There&lt;/h2&gt;
&lt;p&gt;An SPST switch only connects or disconnects the source. When it is open, C1 would keep its charge forever, so R2 gives the capacitor a path to discharge. The price is that R2 also loads the circuit while the switch is closed, so C1 does not reach the full 10 V.&lt;/p&gt;

&lt;h2&gt;Charging: Thevenin Equivalent Seen by C1&lt;/h2&gt;
&lt;div class=&quot;ch-formula&quot;&gt;
$V_{th} = V_1\,\dfrac{R_2}{R_1+R_2} = 10 \times \dfrac{5}{6} \approx \mathbf{8.33\ V}$&lt;br&gt;
$R_{th} = R_1 \parallel R_2 = \dfrac{1000 \times 5000}{6000} \approx 833\ \Omega$&lt;br&gt;
$\tau_{charge} = R_{th}\, C_1 \approx \mathbf{83\ ms}$
&lt;/div&gt;

&lt;h2&gt;Discharging&lt;/h2&gt;
&lt;div class=&quot;ch-formula&quot;&gt;
$\tau_{discharge} = R_2 C_1 = 5000\ \Omega \times 100\ \mu F = \mathbf{0.5\ s}$
&lt;/div&gt;

&lt;div class=&quot;ch-grid&quot;&gt;
&lt;div class=&quot;ch-col blue&quot;&gt;
&lt;h3&gt;Switch closed: charging&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;$v_c(t) = V_{th}\left(1 - e^{-t/\tau_{charge}}\right)$&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Final value:&lt;/strong&gt; 8.33 V (not 10 V)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Settling time:&lt;/strong&gt; $5\tau \approx 0.42\ s$&lt;/li&gt;
&lt;li&gt;The remaining 1.67 V is dropped across R1 by the current that flows through R2: $I = 10/6000 \approx 1.67\ mA$&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;div class=&quot;ch-col red&quot;&gt;
&lt;h3&gt;Switch open: discharging&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;$v_c(t) = V_0\, e^{-t/\tau_{discharge}}$&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;After 0.5 s ($\tau$):&lt;/strong&gt; 36.8 % of V0 (3.07 V from 8.33 V)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;After 2.5 s ($5\tau$):&lt;/strong&gt; 0.7 % of V0, practically 0 V&lt;/li&gt;
&lt;li&gt;Slower than the charge because $R_2 &gt; R_{th}$&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;
&lt;/div&gt;

&lt;h2&gt;How to Run It&lt;/h2&gt;
&lt;div class=&quot;ch-card&quot;&gt;
&lt;ol&gt;
&lt;li&gt;Open the Live panel and press &lt;strong&gt;Run&lt;/strong&gt; (speed: Real time).&lt;/li&gt;
&lt;li&gt;Click the switch to close it: &lt;em&gt;vc&lt;/em&gt; (blue) rises quickly to 8.33 V.&lt;/li&gt;
&lt;li&gt;Click it again to open it: &lt;em&gt;vc&lt;/em&gt; decays slowly to 0 V.&lt;/li&gt;
&lt;li&gt;Try changing R2 (for example to 100 k&amp;Omega;): the final voltage gets closer to 10 V and the discharge becomes much slower.&lt;/li&gt;
&lt;/ol&gt;
&lt;p&gt;The scope shows &lt;em&gt;vc&lt;/em&gt; (blue, voltage across C1) and &lt;em&gt;vsw&lt;/em&gt; (orange, voltage after the switch: 10 V when closed, 0 V when open).&lt;/p&gt;
&lt;/div&gt;

&lt;div class=&quot;ch-card green-border&quot;&gt;
&lt;h2&gt;Conclusion&lt;/h2&gt;
&lt;p style=&quot;line-height: 1.6; margin: 0;&quot;&gt;With an SPST switch the discharge needs its own resistor, and that resistor limits the charge to &lt;strong&gt;8.33 V&lt;/strong&gt; and makes the discharge slower than the charge. With an SPDT switch (see &lt;em&gt;RC Charge Discharge SPDT&lt;/em&gt;) the same capacitor reaches 10 V and discharges through R1.&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
"> 
    <!-- Parent container that responds to mouse movement -->
    <div class="chtool"> 
        
        <!-- tool bar-->
        <div class="ch-page-toolbar" style="zoom: 1.36986;">
