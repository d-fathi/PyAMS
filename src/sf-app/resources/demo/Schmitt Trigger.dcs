        <span><span class="katex-display"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.8333em; vertical-align: -0.15em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3283em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight" style="margin-right: 0.109em;">U</span><span class="mord mathnormal mtight" style="margin-right: 0.1389em;">T</span><span class="mord mathnormal mtight" style="margin-right: 0.1389em;">P</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.8889em; vertical-align: -0.1944em;"></span><span class="mord">+</span><span class="mord mathnormal" style="margin-right: 0.0528em;">β</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.2806em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">s</span><span class="mord mathnormal mtight">a</span><span class="mord mathnormal mtight">t</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.8778em; vertical-align: -0.1944em;"></span><span class="mord">+</span><span class="mord">4</span><span class="mspace">&nbsp;</span><span class="mord mathrm" style="margin-right: 0.0139em;">V</span><span class="mpunct">,</span><span class="mspace" style="margin-right: 2em;"></span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3283em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">L</span><span class="mord mathnormal mtight" style="margin-right: 0.1389em;">T</span><span class="mord mathnormal mtight" style="margin-right: 0.1389em;">P</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.8889em; vertical-align: -0.1944em;"></span><span class="mord">−</span><span class="mord mathnormal" style="margin-right: 0.0528em;">β</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.2806em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">s</span><span class="mord mathnormal mtight">a</span><span class="mord mathnormal mtight">t</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.7667em; vertical-align: -0.0833em;"></span><span class="mord">−</span><span class="mord">4</span><span class="mspace">&nbsp;</span><span class="mord mathrm" style="margin-right: 0.0139em;">V</span></span></span></span></span></span>
        <span><span class="katex-display"><span class="katex"><span class="katex-html" aria-hidden="true"><span class="base"><span class="strut" style="height: 0.8333em; vertical-align: -0.15em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3283em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mathnormal mtight" style="margin-right: 0.0813em;">H</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.8333em; vertical-align: -0.15em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3283em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight" style="margin-right: 0.109em;">U</span><span class="mord mathnormal mtight" style="margin-right: 0.1389em;">T</span><span class="mord mathnormal mtight" style="margin-right: 0.1389em;">P</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right: 0.2222em;"></span></span><span class="base"><span class="strut" style="height: 0.8333em; vertical-align: -0.15em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.3283em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">L</span><span class="mord mathnormal mtight" style="margin-right: 0.1389em;">T</span><span class="mord mathnormal mtight" style="margin-right: 0.1389em;">P</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.8889em; vertical-align: -0.1944em;"></span><span class="mord">2</span><span class="mord mathnormal" style="margin-right: 0.0528em;">β</span><span class="mspace" style="margin-right: 0.1667em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right: 0.2222em;">V</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height: 0.2806em;"><span class="" style="top: -2.55em; margin-left: -0.2222em; margin-right: 0.05em;"><span class="pstrut" style="height: 2.7em;"></span><span class="sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mathnormal mtight">s</span><span class="mord mathnormal mtight">a</span><span class="mord mathnormal mtight">t</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height: 0.15em;"><span class=""></span></span></span></span></span></span><span class="mspace" style="margin-right: 0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right: 0.2778em;"></span></span><span class="base"><span class="strut" style="height: 0.6833em;"></span><span class="mord">8</span><span class="mspace">&nbsp;</span><span class="mord mathrm" style="margin-right: 0.0139em;">V</span></span></span></span></span></span>
    </div>

    <h2>How the Circuit Works</h2>
    <div class="ch-grid">
        <div class="ch-col blue">
            <h3>Output High (+12 V)</h3>
            <ul>
                <li>The (+) input voltage is p = +4 V.</li>
                <li>The output stays high as long as Vin is below +4 V.</li>
                <li>When Vin rises above <strong>+4 V</strong> the differential input turns negative and the output switches to −12 V.</li>
            </ul>
        </div>
        <div class="ch-col red">
            <h3>Output Low (−12 V)</h3>
            <ul>
                <li>The (+) input voltage is p = −4 V.</li>
                <li>The output stays low as long as Vin is above −4 V.</li>
                <li>When Vin falls below <strong>−4 V</strong> the output switches back to +12 V.</li>
            </ul>
        </div>
    </div>
    <p style="line-height: 1.6;">Because the input is applied to the inverting terminal, the circuit is <strong>inverting</strong>: the output is a square wave in opposition to the input. The <strong>p</strong> curve in the plot is the threshold voltage itself, and it toggles between +4 V and −4 V at every switching event.</p>

    <h2>Simulation Results (Transient, 0 - 3 ms)</h2>
    <div class="ch-grid">
        <div class="ch-col blue">
            <h3>Switching</h3>
            <ul>
                <li>Switches low when Vin ≈ <strong>+4.1 V</strong> (for example at 0.12 ms).</li>
                <li>Switches high when Vin ≈ <strong>−4.1 V</strong> (for example at 0.62 ms).</li>
                <li>The small excess above 4 V comes from the 5 µs simulation step and the finite response time of the op-amp.</li>
            </ul>
        </div>
        <div class="ch-col red">
            <h3>Output</h3>
            <ul>
                <li>Square wave between <strong>+11.97 V</strong> and <strong>−11.97 V</strong> (close to ±12 V).</li>
                <li>Period of 1 ms, the same frequency as the input (1 kHz).</li>
                <li>The voltage p swings between <strong>+3.99 V</strong> and <strong>−3.99 V</strong>.</li>
            </ul>
        </div>
    </div>

    <div class="ch-card green-border">
        <h2>Conclusion</h2>
        <p style="line-height: 1.6; margin: 0;">The circuit converts any signal that crosses ±4 V into a ±12 V square wave, and it ignores any ripple or noise smaller than the hysteresis gap (8 V). The hysteresis width depends only on the resistor ratio and the saturation voltage, not on the input frequency. Typical applications include noise removal, switch debouncing, level detection and relaxation oscillators.</p>
    </div>

    <div class="ch-card">
        <h2>Try It Yourself</h2>
        <ul style="line-height: 1.6; margin: 0;">
            <li>Run the <strong>transient analysis</strong> and compare the in, out and p curves.</li>
            <li>Change R1 to 10 KΩ so the thresholds become ±6 V: a 6 V input barely makes the output switch.</li>
            <li>Reduce the amplitude of Vin to 3 V (below the 4 V threshold) and the output never changes. This is the effect of hysteresis.</li>
            <li>Make R1 very small to enlarge the thresholds, or very large to shrink them toward an ordinary comparator.</li>
        </ul>
    </div>

</div>

    </div>
    </div></foreignObject></g><g transform="translate(349,40)" x="349" y="40" width="431" height="148" class="analysis" name="analysis" description="{&quot;type&quot;:&quot;Time Domain&quot;,&quot;title&quot;:&quot;&quot;,&quot;dcsweep&quot;:{&quot;param&quot;:&quot;Non&quot;,&quot;unit&quot;:&quot;&quot;,&quot;start&quot;:&quot;0&quot;,&quot;stop&quot;:&quot;0&quot;,&quot;step&quot;:&quot;0&quot;,&quot;modified&quot;:false},&quot;time&quot;:{&quot;start&quot;:&quot;0.1ms&quot;,&quot;stop&quot;:&quot;3ms&quot;,&quot;step&quot;:&quot;0.005ms&quot;,&quot;modified&quot;:false},&quot;ac&quot;:{&quot;start&quot;:&quot;1&quot;,&quot;stop&quot;:&quot;1000&quot;,&quot;step&quot;:&quot;100&quot;,&quot;scale&quot;:&quot;dec&quot;,&quot;type&quot;:&quot;de&quot;,&quot;modified&quot;:false},&quot;yAxe&quot;:[{&quot;name&quot;:&quot;out&quot;,&quot;color&quot;:&quot;#ea2e2e&quot;}],&quot;xAxe&quot;:{&quot;name&quot;:&quot;in&quot;,&quot;unit&quot;:&quot;&quot;,&quot;type&quot;:&quot;&quot;,&quot;color&quot;:&quot;#000000&quot;,&quot;used&quot;:true},&quot;layout&quot;:{&quot;margin&quot;:{&quot;l&quot;:35,&quot;r&quot;:25,&quot;b&quot;:80,&quot;t&quot;:35},&quot;font&quot;:{&quot;color&quot;:&quot;#333333&quot;,&quot;size&quot;:11,&quot;family&quot;:&quot;Arial&quot;},&quot;paper_bgcolor&quot;:&quot;#ffffff&quot;,&quot;plot_bgcolor&quot;:&quot;#f8f8f8&quot;,&quot;bordercolor&quot;:&quot;#cccccc&quot;,&quot;yaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;xaxis&quot;:{&quot;type&quot;:&quot;linear&quot;,&quot;gridcolor&quot;:&quot;#e0e0e0&quot;,&quot;showgrid&quot;:true},&quot;showlegend&quot;:true,&quot;grid&quot;:{&quot;rows&quot;:1,&quot;columns&quot;:1,&quot;pattern&quot;:&quot;independent&quot;,&quot;roworder&quot;:&quot;bottom to top&quot;}},&quot;options&quot;:{},&quot;sweep&quot;:{&quot;param&quot;:&quot;&quot;,&quot;values&quot;:&quot;[]&quot;}}"><foreignObject x="0" y="0" width="431" height="148"