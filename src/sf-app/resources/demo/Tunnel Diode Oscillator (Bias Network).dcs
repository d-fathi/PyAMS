1f"><rect width="70" height="58" x="0" y="0"></rect></clipPath></defs><g class="indicatorlayer"></g><g class="layer-above"><g class="imagelayer"></g><g class="shapelayer"></g></g><g class="infolayer"><g class="legend" pointer-events="all" transform="translate(611.62,35)"><rect class="bg" shape-rendering="crispEdges" style="stroke: rgb(68, 68, 68); stroke-opacity: 1; fill: rgb(255, 255, 255); fill-opacity: 1; stroke-width: 0px;" width="70" height="58" x="0" y="0"></rect><g class="scrollbox" transform="" clip-path="url('#legendb0391f')"><g class="groups" transform=""><g class="traces" transform="translate(0,14.5)" style="opacity: 1;"><text class="legendtext" text-anchor="start" x="40" y="4.29" data-unformatted="T [V]" data-math="N" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">T [V]</text><g class="layers" style="opacity: 1;"><g class="legendfill"></g><g class="legendlines"><path class="js-line" d="M5,0h30" style="fill: none; stroke: rgb(42, 115, 192); stroke-opacity: 1; stroke-width: 1.5px;"></path></g><g class="legendsymbols"><g class="legendpoints"></g></g></g><rect class="legendtoggle" pointer-events="all" x="0" y="-9.5" width="64.25" height="19" style="cursor: pointer; fill: rgb(0, 0, 0); fill-opacity: 0;"></rect></g></g><g class="groups" transform="translate(0,10)"><g class="traces" transform="translate(0,33.5)" style="opacity: 1;"><text class="legendtext" text-anchor="start" x="40" y="4.29" data-unformatted="A [V]" data-math="N" style="font-family: Arial; font-size: 11px; fill: rgb(51, 51, 51); fill-opacity: 1; white-space: pre;">A [V]</text><g class="layers" style="opacity: 1;"><g class="legendfill"></g><g class="legendlines"><path class="js-line" d="M5,0h30" style="fill: none; stroke: rgb(211, 54, 54); stroke-opacity: 1; stroke-width: 1.5px;"></path></g><g class="legendsymbols"><g class="legendpoints"></g></g></g><rect class="legendtoggle" pointer-events="all" x="0" y="-9.5" width="64.25" height="19" st